{
  "name": "titen-memory",
  "version": "0.6.1",
  "description": "The Level 6 collaborative memory fabric for AI agents — evidence-grounded observe/claim/compile/feedback over Bun+SQLite or Cloudflare Workers+D1",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamaAditya49/titen.git"
  },
  "homepage": "https://titen.dev",
  "bugs": "https://github.com/RamaAditya49/titen/issues",
  "keywords": [
    "agent-memory",
    "memory",
    "rag",
    "context",
    "mcp",
    "bun",
    "sqlite",
    "cloudflare-workers"
  ],
  "bin": {
    "titen": "src/runtime/bun/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/npm/sdk.d.ts",
      "bun": "./dist/npm/sdk.js",
      "default": "./dist/npm/sdk.js"
    },
    "./sdk": {
      "types": "./dist/npm/sdk.d.ts",
      "bun": "./dist/npm/sdk.js",
      "default": "./dist/npm/sdk.js"
    },
    "./bun": {
      "bun": "./src/runtime/bun/server.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "SECURITY.md",
    "src/core",
    "src/runtime/bun",
    "src/sdk.ts",
    "dist/npm"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "peerDependencies": {
    "sqlite-vec": "0.1.9"
  },
  "peerDependenciesMeta": {
    "sqlite-vec": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dashboard-bundle.mjs",
    "preview": "astro preview",
    "test": "pnpm build && playwright test",
    "test:browser": "playwright test",
    "test:api": "pnpm build:worker && pnpm test:d1 && bun test tests/contract/bun-sqlite.test.ts tests/contract/vectors.test.ts tests/sdk",
    "test:d1": "bun test tests/contract/d1-harness.test.ts && bun build tests/contract/cloudflare-d1.test.ts --outfile dist/test/cloudflare-d1.test.mjs --target node --format esm --external miniflare && node --test dist/test/cloudflare-d1.test.mjs",
    "test:all": "pnpm test:api && pnpm test:integration && pnpm verify:dashboard-live && pnpm test && pnpm check:workflow",
    "build:worker": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist/worker",
    "build:npm": "bun build src/sdk.ts --outfile dist/npm/sdk.js --target node --format esm && tsc -p tsconfig.sdk.json && tsc -p tsconfig.sdk-contract.json",
    "prepack": "bun run build:npm",
    "deploy:worker": "WRANGLER_SEND_METRICS=false wrangler deploy",
    "titen": "bun src/runtime/bun/cli.ts",
    "screenshots": "UPDATE_DASHBOARD_SCREENSHOTS=1 playwright test tests/dashboard-screenshots.spec.ts",
    "check:routes": "node scripts/check-route-docs.mjs",
    "check:workflow": "node scripts/check-workflow-docs.mjs && node scripts/check-workflow-docs.mjs --self-test && node scripts/check-ponytail-debt.mjs",
    "check:ponytail": "node scripts/check-ponytail-debt.mjs",
    "verify:dashboard-live": "bun scripts/verify-dashboard-live.ts",
    "verify:live": "bun scripts/verify-live.ts",
    "test:integration": "bun test tests/integration",
    "example:golden-path": "bun examples/small-team-golden-path.ts",
    "dashboard:adapter": "bun scripts/dashboard-adapter.ts",
    "test:adapter": "bun test tests/integration/dashboard-adapter.test.ts",
    "benchmark:retrieval": "bun scripts/benchmark-retrieval-h2h.ts"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.62.0",
    "astro": "7.1.4",
    "miniflare": "4.20260730.0",
    "wrangler": "4.116.0",
    "sqlite-vec": "0.1.9",
    "typescript": "5.9.3"
  }
}
