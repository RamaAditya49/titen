            const status = String(row.status);
            const actions = status === "draft" || status === "suspended" ? ["approve"]
              : status === "approved" ? ["activate", "revoke"] : status === "active" ? ["revoke"] : [];
            return actions.map((action) => ({
              label: `${action[0]!.toUpperCase()}${action.slice(1)} · ${row.release_id}`,
              tone: action === "revoke" ? "danger" as const : "default" as const,
