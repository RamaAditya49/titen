      function updateMemoryRequirements() {
        const selected = one<HTMLInputElement>('input[name="lens"]:checked');
        const subject = memoryForm.elements.namedItem("subject_id") as HTMLInputElement;
        const focus = memoryForm.elements.namedItem("focus_id") as HTMLInputElement;
        const lens = selected.value;
        subject.required = selected.dataset.needs === "subject";
        focus.required = selected.dataset.needs === "focus";
        text("[data-subject-help]", subject.required ? "Required for the selected lens." : lens === "review_queue" ? "Optional review filter." : lens === "workspace_graph" ? "Graph follows the active workspace picker." : "Not used by this lens.");
        const copy = lens === "evidence_trace" ? ["Focus claim ID", "claim ID", "Required for Evidence trace."]
          : lens === "scope_preview" ? ["Focus principal ID", "principal ID", "Required for Scope preview."]
          : lens === "knowledge_release" ? ["Focus channel ID", "optional channel ID", "Optional channel filter."]
          : ["Focus ID", "not used", "Not used by this lens."];
