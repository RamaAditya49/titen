          renderPayload(one("[data-embedding-model]"), { data: data.embedding as Record<string, unknown> });
          const extraction = data.extraction as Record<string, unknown> | undefined;
          const embedding = data.embedding as Record<string, unknown> | undefined;
          const lines = [
            extraction?.base_url ? `TITEN_EXTRACT_BASE_URL=${extraction.base_url}` : "",
            extraction?.model ? `TITEN_EXTRACT_MODEL=${extraction.model}` : "",
