    <script>
      import {
        DashboardApiError,
        changePassword,
        checkService,
        compileView,
        deleteArea,
        getArea,
        getDashboardStatus,
        getSession,
        listMemories,
        login,
        logout,
        postArea,
        type AtlasNode,
        type AtlasView,
        type DashboardPrincipal,
        type DashboardStatus,
        type MemoryRecord,
      } from "../../lib/dashboard-api";
      import {
        renderCollection,
        renderPayloadView,
      } from "../../lib/dashboard-view";

      const one = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
      const all = <T extends Element>(selector: string) => [...document.querySelectorAll<T>(selector)];
      const memoryForm = one<HTMLFormElement>("[data-memory-form]");
      const memoryRun = one<HTMLButtonElement>("[data-memory-run]");
      const memoryRecords = one<HTMLElement>("[data-memory-records]");
      const memoryEmpty = one<HTMLElement>("[data-memory-empty]");
      const memoryLoading = one<HTMLElement>("[data-memory-loading]");
      const memoryError = one<HTMLElement>("[data-memory-error]");
      const memoryListForm = one<HTMLFormElement>("[data-memory-list-form]");
      const memoryListSearch = one<HTMLInputElement>("[data-memory-list-search]");
      const memoryListStatus = one<HTMLSelectElement>("[data-memory-list-status]");
      const memoryListRows = one<HTMLElement>("[data-memory-list-rows]");
      const memoryListLoading = one<HTMLElement>("[data-memory-list-loading]");
      const memoryListEmpty = one<HTMLElement>("[data-memory-list-empty]");
      const memoryListError = one<HTMLElement>("[data-memory-list-error]");
      const memoryListTable = one<HTMLElement>("[data-memory-list-table]");
      const memoryListNext = one<HTMLButtonElement>("[data-memory-list-next]");
      const memoryListPrev = one<HTMLButtonElement>("[data-memory-list-prev]");
      const memoryListPage = one<HTMLElement>("[data-memory-list-page]");
      const atlasGraph = one<HTMLElement>("[data-atlas-graph]");
      const atlasEdges = one<SVGElement>("[data-atlas-edges]");
      const atlasNodes = one<HTMLElement>("[data-atlas-nodes]");
      const compileTrace = one<HTMLElement>("[data-compile-trace]");
      const searchDialog = one<HTMLDialogElement>("[data-search-dialog]");
      const searchForm = one<HTMLFormElement>("[data-search-form]");
      const workspacePicker = one<HTMLSelectElement>("[data-workspace-picker]");
      const workspaceMenu = one<HTMLDetailsElement>("[data-workspace-menu]");
      let view: AtlasView | null = null;
      let principal: DashboardPrincipal | null = null;
      let dashboardStatus: DashboardStatus | null = null;
      let generation = 0;
      let memoryListCursor: string | null = null;
      let memoryListAfter: string | null = null;
      let memoryListHistory: string[] = [];
      let memoryKind = "";
      let graphSelected: AtlasNode | null = null;

      const text = (selector: string, value: string) => { one<HTMLElement>(selector).textContent = value; };
      const has = (scope: string) => Boolean(principal?.scopes.includes("*") || principal?.scopes.includes(scope));
      function payloadData(payload: Record<string, unknown>): Record<string, unknown> {
        return payload.data && typeof payload.data === "object" && !Array.isArray(payload.data)
          ? payload.data as Record<string, unknown> : payload;
      }
      function serviceDetail(payload: Record<string, unknown>, key: string): string | undefined {
        const value = payloadData(payload)[key];
        if (typeof value === "string") return value;
        const meta = payload.meta;
        const metaValue = meta && typeof meta === "object" && !Array.isArray(meta)
          ? (meta as Record<string, unknown>)[key] : undefined;
        return typeof metaValue === "string" ? metaValue : undefined;
      }
      function semanticDiagnostic(payload: Record<string, unknown>): string | undefined {
        const checks = payloadData(payload).checks;
        if (!checks || typeof checks !== "object" || Array.isArray(checks)) return undefined;
        const diagnostic = (checks as Record<string, unknown>).semantic_index;
        return typeof diagnostic === "string" ? diagnostic : undefined;
      }
      function renderPrincipalDetails(selector: string) {
        const target = one<HTMLDListElement>(selector);
        target.replaceChildren();
        if (!principal) return;
        for (const [label, value] of [
          ["Principal", principal.principal_id], ["Type", principal.principal_kind],
          ["Organization", principal.organization_id], ["Role", principal.organization_role ?? "none"],
          ["Trust ceiling", principal.max_trust], ["Scopes", principal.scopes.join(", ") || "none"],
        ] as const) {
          const term = document.createElement("dt");
          const description = document.createElement("dd");
          term.textContent = label;
          description.textContent = value;
          target.append(term, description);
        }
      }
      function renderAccessPolicy() {
        renderPrincipalDetails("[data-access-details]");
        renderPrincipalDetails("[data-profile-details]");
      }
      function setNotice(element: HTMLElement, message?: string) {
        element.hidden = !message;
        element.textContent = message ?? "";
      }
      function errorMessage(error: unknown): string {
        if (error instanceof DashboardApiError) {
          if (error.status === 401) return "Your dashboard session is no longer valid. Sign in again.";
          if (error.status === 403) return "This principal is not authorized for that operation.";
          if (error.status === 404) return "The authorized resource was not found.";
          if (error.status === 503) return "Titen is not ready. Inspect readiness before retrying.";
          return error.message;
        }
        return "The same-origin dashboard adapter is unreachable.";
      }
      function handleError(error: unknown, target?: HTMLElement) {
        if (error instanceof DashboardApiError && error.status === 401 && dashboardStatus?.authentication === "session") signedOut(errorMessage(error));
        else if (target) renderMessage(target, errorMessage(error), true);
        else setNotice(one("[data-service-notice]"), errorMessage(error));
      }

      function renderMessage(target: HTMLElement, message: string, danger = false) {
        target.replaceChildren();
        const paragraph = document.createElement("p");
        paragraph.textContent = message;
        if (danger) paragraph.className = "output-error";
        target.append(paragraph);
      }
      function renderPayload(
        target: HTMLElement,
        payload: Record<string, unknown>,
        options: Parameters<typeof renderPayloadView>[2] = {},
      ) {
        renderPayloadView(target, payloadData(payload), options);
      }
      function renderContext(target: HTMLElement, payload: Record<string, unknown>) {
        const data = payloadData(payload);
        const budget = data.budget && typeof data.budget === "object" && !Array.isArray(data.budget)
          ? data.budget as Record<string, unknown> : {};
        const used = Number(budget.used_tokens ?? 0);
        const maximum = Math.max(1, Number(budget.max_tokens ?? used));
        target.replaceChildren();
        const meter = document.createElement("section");
        meter.className = "context-budget";
        const title = document.createElement("h3");
        title.textContent = `Token budget · ${used.toLocaleString()} / ${maximum.toLocaleString()}`;
        const progress = document.createElement("progress");
        progress.max = maximum;
        progress.value = Math.min(used, maximum);
        progress.setAttribute("aria-label", "Context token budget used");
        const summary = document.createElement("p");
        summary.textContent = `${budget.selected_items ?? 0} selected · ${budget.omitted_items ?? 0} omitted · ${budget.deduplicated_items ?? 0} deduplicated`;
        meter.append(title, progress, summary);
        target.append(meter);
        const records = document.createElement("div");
        target.append(records);
        renderPayload(records, { data: { items: data.items ?? [], conflicts: data.conflicts ?? [], instructions: data.instructions, policy_snapshot: data.policy_snapshot } });
