      function renderMemoryList(records: MemoryRecord[], hasMore: boolean) {
        memoryListRows.replaceChildren();
        memoryListTable.hidden = records.length === 0;
        memoryListEmpty.hidden = records.length !== 0;
        for (const record of records) {
          const row = document.createElement("tr");
          const statement = document.createElement("th");
          statement.scope = "row";
          highlighted(statement, record.statement, memoryListSearch.value);
          const cells = [memoryKindLabel(record.kind), record.trust, record.status, formatDate(record.created_at) ?? record.created_at];
          row.append(statement, ...cells.map((value) => { const cell = document.createElement("td"); cell.textContent = value; return cell; }));
          const action = document.createElement("td");
          const button = document.createElement("button");
          button.type = "button";
          button.className = "text-button";
          button.textContent = "Open in Atlas";
          button.addEventListener("click", () => openMemoryInAtlas(record));
          action.append(button);
          row.append(action);
          memoryListRows.append(row);
        }
        memoryListNext.disabled = !hasMore;
        memoryListPrev.disabled = memoryListHistory.length === 0;
        text("[data-memory-list-status-text]", records.length ? `${records.length} authorized memories shown${hasMore ? " · more available" : ""}.` : "No authorized memories match these filters.");
        memoryListPage.textContent = hasMore ? "More authorized records available" : "End of authorized records";
      }
      async function loadMemoryList(after: string | null = null) {
        memoryListAfter = after;
        memoryListLoading.hidden = false;
        memoryListTable.hidden = true;
        memoryListEmpty.hidden = true;
        setNotice(memoryListError);
        memoryListNext.disabled = true;
        memoryListPrev.disabled = true;
        const query = new URLSearchParams();
        const search = memoryListSearch.value.trim();
        const status = memoryListStatus.value;
        if (search) query.set("q", search);
        if (status) query.set("status", status);
        if (memoryKind) query.set("kind", memoryKind);
        if (workspacePicker.value) query.set("workspace_id", workspacePicker.value);
        if (after) query.set("after", after);
        try {
          const page = await listMemories(query);
          memoryListCursor = page.page.next_cursor;
          renderMemoryList(page.items, page.page.has_more);
          const facets = one<HTMLElement>("[data-memory-facets]");
          facets.replaceChildren();
          for (const [group, values] of Object.entries(page.facets ?? {}))
            for (const [value, count] of Object.entries(values)) {
              const button = document.createElement("button");
              button.type = "button";
              button.className = "filter-chip";
              button.textContent = `${memoryKindLabel(value)} · ${count}`;
              button.setAttribute("aria-pressed", String(group === "kind" ? memoryKind === value : memoryListStatus.value === value));
              button.addEventListener("click", () => {
                if (group === "kind") memoryKind = memoryKind === value ? "" : value;
                else memoryListStatus.value = memoryListStatus.value === value ? "" : value;
                memoryListHistory = [];
                void loadMemoryList();
              });
              facets.append(button);
            }
        } catch (error) {
          memoryListRows.replaceChildren();
          memoryListEmpty.hidden = true;
          setNotice(memoryListError, errorMessage(error));
          handleError(error);
          text("[data-memory-list-status-text]", "Unable to load authorized memories.");
        } finally { memoryListLoading.hidden = true; }
      }

