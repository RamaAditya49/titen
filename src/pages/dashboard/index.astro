      function memoryKindLabel(kind: string): string { return kind.replaceAll("_", " "); }
      function highlighted(target: HTMLElement, value: string, query: string) {
        target.replaceChildren();
        const needle = query.trim();
        if (!needle) return target.append(document.createTextNode(value));
        const index = value.toLocaleLowerCase().indexOf(needle.toLocaleLowerCase());
        if (index < 0) return target.append(document.createTextNode(value));
        target.append(document.createTextNode(value.slice(0, index)));
        const mark = document.createElement("mark");
        mark.textContent = value.slice(index, index + needle.length);
        target.append(mark, document.createTextNode(value.slice(index + needle.length)));
      }
      function openMemoryInAtlas(record: MemoryRecord) {
