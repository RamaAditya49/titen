            const decisions = row.status === "pending" ? ["approve", "reject"] : ["revoke"];
            return decisions.map((decision) => ({
              label: `${decision[0]!.toUpperCase()}${decision.slice(1)} · ${row.claim_id}`,
              tone: decision === "approve" ? "default" as const : "danger" as const,
