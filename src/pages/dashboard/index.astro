---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/jetbrains-mono";
import "../../styles/dashboard.css";
import titenMark from "../../../docs/assets/brand/titen-mark.svg?url";
import packageJson from "../../../package.json";

const productAreas = [
  { id: "memories", label: "Memories", scopes: "views:compile" },
  { id: "context", label: "Context", scopes: "context:compile" },
  { id: "work", label: "Work", scopes: "checkpoints:read leases:read handoffs:read" },
  { id: "audit", label: "Audit", scopes: "audit:read events:read" },
  { id: "governance", label: "Governance", scopes: "governance:read approvals:read releases:read memberships:read keys:manage" },
  { id: "federation", label: "Federation", scopes: "federation:read" },
];
const lenses = [
  { id: "neighborhood", label: "Neighborhood", needs: "subject", scope: "" },
  { id: "evidence_trace", label: "Evidence trace", needs: "focus", scope: "" },
  { id: "conflict_freshness", label: "Conflict & freshness", needs: "subject", scope: "" },
  { id: "review_queue", label: "Review queue", needs: "optional", scope: "" },
  { id: "scope_preview", label: "Scope preview", needs: "focus", scope: "governance:read" },
  { id: "knowledge_release", label: "Knowledge releases", needs: "optional", scope: "releases:read" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Titen operator dashboard — live memory, context, work, audit, governance, and federation." />
    <title>Titen · Operator dashboard</title>
  </head>
  <body>
    <svg class="icon-sprite" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="icon-observation" viewBox="0 0 100 100"><rect x="24" y="16" width="52" height="68" rx="3" fill="none" stroke="currentColor" stroke-width="6"/><path d="M36 38h28M36 52h28" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><path d="M36 66h16" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round"/></symbol>
        <symbol id="icon-claim" viewBox="0 0 100 100"><circle cx="26" cy="42" r="12" fill="currentColor"/><path d="M44 42h40M26 68h44" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/><path d="M26 68h44" fill="none" stroke="var(--accent)" stroke-width="7" stroke-linecap="round"/></symbol>
        <symbol id="icon-context" viewBox="0 0 100 100"><circle cx="50" cy="50" r="11" fill="currentColor"/><path d="M14 34l12 12-12 12M86 34L74 46l12 12M36 84l12-12 12 12" fill="none" stroke="currentColor" stroke-width="6.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M36 84l12-12" fill="none" stroke="var(--accent)" stroke-width="6.4" stroke-linecap="round"/></symbol>
        <symbol id="icon-atlas" viewBox="0 0 100 100"><circle cx="50" cy="50" r="10" fill="var(--accent)"/><g fill="currentColor"><circle cx="20" cy="24" r="7"/><circle cx="80" cy="24" r="7"/><circle cx="20" cy="76" r="7"/><circle cx="80" cy="76" r="7"/></g><g fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity=".5"><path d="M27 29l16 15M73 29L57 44M27 71l16-15M73 71L57 56"/></g></symbol>
        <symbol id="icon-work" viewBox="0 0 100 100"><path d="M28 16v68M28 22h48L64 40l12 18H28" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="28" cy="76" r="8" fill="var(--accent)"/></symbol>
        <symbol id="icon-audit" viewBox="0 0 100 100"><g fill="currentColor"><circle cx="24" cy="30" r="5"/><circle cx="24" cy="50" r="5"/><circle cx="24" cy="70" r="5"/></g><path d="M42 30h42M42 50h42M42 70h26" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><path d="M42 70h26" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round"/></symbol>
        <symbol id="icon-system" viewBox="0 0 100 100"><path d="M10 54h20l8-22 12 42 10-20h30" fill="none" stroke="currentColor" stroke-width="6.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="icon-access" viewBox="0 0 100 100"><circle cx="34" cy="50" r="16" fill="none" stroke="currentColor" stroke-width="6.4"/><path d="M50 50h38M70 50v14M84 50v12" fill="none" stroke="var(--accent)" stroke-width="6.4" stroke-linecap="round"/></symbol>
        <symbol id="icon-governance" viewBox="0 0 100 100"><path d="M50 12l30 12v28c0 18-14 30-30 36-16-6-30-18-30-36V24z" fill="none" stroke="currentColor" stroke-width="6.4"/><path d="M36 50l11 11 19-21" fill="none" stroke="var(--accent)" stroke-width="6.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="icon-release" viewBox="0 0 100 100"><rect x="16" y="26" width="46" height="52" rx="3" fill="none" stroke="currentColor" stroke-width="6"/><path d="M62 38h26M78 28l10 10-10 10" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="icon-federation" viewBox="0 0 100 100"><ellipse cx="50" cy="25" rx="15" ry="25" fill="none" stroke="currentColor" stroke-width="5"/><ellipse cx="50" cy="75" rx="15" ry="25" fill="none" stroke="currentColor" stroke-width="5"/><ellipse cx="25" cy="50" rx="25" ry="15" fill="none" stroke="currentColor" stroke-width="5"/><ellipse cx="75" cy="50" rx="25" ry="15" fill="none" stroke="currentColor" stroke-width="5"/><circle cx="50" cy="50" r="8" fill="var(--accent)"/></symbol>
        <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
        <symbol id="icon-disconnect" viewBox="0 0 24 24"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3M13 12h8M17 8l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      </defs>
    </svg>
    <a class="skip-link" href="#workspace">Skip to workspace</a>
    <div class="app-shell" data-shell="loading">
      <aside class="sidebar" aria-label="Product areas">
        <header class="brand-row">
          <img src={titenMark} width="24" height="24" alt="" />
          <strong>titen</strong>
          <span>v{packageJson.version}</span>
        </header>

        <nav data-product-nav hidden>
          <p class="nav-group-label">Memory</p>
          <button type="button" data-area="memories" data-label="Memory Atlas" data-scopes={productAreas[0].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-atlas"></use></svg>Atlas</span>
            <small>live</small>
          </button>
          <button type="button" class="nav-alias" data-area="memories" data-label="Memory Atlas" data-scopes={productAreas[0].scopes}>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-observation"></use></svg>Memories</span><small>query</small>
          </button>
          <button type="button" data-area="context" data-label="Context" data-scopes={productAreas[1].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-context"></use></svg>Context</span>
            <small>live</small>
          </button>

          <p class="nav-group-label">Collaboration</p>
          <button type="button" data-area="work" data-label="Work" data-scopes={productAreas[2].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-work"></use></svg>Work</span>
            <small>live</small>
          </button>

          <p class="nav-group-label">Operations</p>
          <button type="button" data-area="audit" data-label="Audit & Events" data-scopes={productAreas[3].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-audit"></use></svg>Audit &amp; Events</span>
            <small>live</small>
          </button>
          <button type="button" data-area="system" data-label="System status" data-scopes="">
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-system"></use></svg>System</span><small>status</small>
          </button>
          <button type="button" data-area="federation" data-label="Federation" data-scopes={productAreas[5].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-federation"></use></svg>Federation</span>
            <small>live</small>
          </button>

          <p class="nav-group-label">Administration</p>
          <button type="button" data-area="access" data-label="Access policy" data-scopes="identity:read">
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-access"></use></svg>Access</span><small>policy</small>
          </button>

          <p class="nav-group-label">Governance</p>
          <button type="button" data-area="governance" data-label="Governance" data-scopes={productAreas[4].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-governance"></use></svg>Approvals</span>
            <small>live</small>
          </button>
          <button type="button" data-area="releases" data-label="Release policy" data-scopes="releases:read">
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-release"></use></svg>Releases</span><small>policy</small>
          </button>
        </nav>

        <section class="credential-note" aria-label="Credential handling">
          <button type="button" class="profile-button" data-profile-open hidden>
            <span class="profile-avatar" data-profile-avatar>OP</span>
            <span><strong data-profile-name>operator</strong><small data-profile-role>profile · principal</small></span>
          </button>
          <p>Credential boundary</p>
          <strong data-credential-mode>Server-only</strong>
          <span data-credential-copy>Passwords and session keys never enter browser storage.</span>
          <button type="button" class="text-button" data-logout aria-label="Sign out" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-disconnect"></use></svg>Disconnect</button>
        </section>
      </aside>

      <main id="workspace" class="main-shell" tabindex="-1">
        <header class="topbar">
          <div class="topbar-title">
            <div class="breadcrumb"><span data-breadcrumb-area>Authorized operator surface</span><span>/</span><span data-breadcrumb-page>Dashboard</span></div>
            <div class="topbar-heading"><h1 data-page-title>Titen dashboard</h1><span class="read-only-badge">read-only</span><span class="javanese" title="titen">ꦠꦶꦠꦺꦤ꧀</span></div>
          </div>
          <div class="topbar-actions">
            <button type="button" class="search-button" data-search-open aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-search"></use></svg><span>Search or jump to…</span><kbd>⌘K</kbd></button>
            <span class="topbar-rule" aria-hidden="true"></span>
            <div class="connection" role="status" aria-live="polite">
              <i data-connection-dot></i>
              <span data-connection-label>Connecting</span>
              <small data-endpoint>same-origin adapter</small>
            </div>
          </div>
        </header>

        <section class="login-panel" data-login-panel hidden aria-labelledby="login-heading">
          <div class="login-intro">
            <div class="login-brand" aria-label={`Titen version ${packageJson.version}`}>
              <img src={titenMark} width="32" height="32" alt="" />
              <strong>titen</strong>
              <span>v{packageJson.version}</span>
            </div>
            <div>
              <p class="eyebrow">Private operator access</p>
              <h1 id="login-heading" data-login-heading>Sign in</h1>
              <p data-login-copy>Use the operator account issued by your Titen organization.</p>
            </div>
            <p class="login-intro-note">Your permissions decide which memory, work, audit, governance, and federation tools become available.</p>
          </div>
          <form data-login-form>
            <label>
              <span>Username</span>
              <input name="username" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="64" required placeholder="owner" />
            </label>
            <label>
              <span>Password</span>
              <input name="password" type="password" autocomplete="current-password" maxlength="128" required />
            </label>
            <button class="primary-button" type="submit">Continue</button>
            <p class="login-boundary"><strong>Kept off this device.</strong> The adapter exchanges your account for an HttpOnly session and clears both fields after submission.</p>
            <span data-login-status role="status" aria-live="polite"></span>
          </form>
          <form data-password-form hidden>
            <label>
              <span>New password</span>
              <input name="password" type="password" autocomplete="new-password" minlength="15" maxlength="128" required />
            </label>
            <label>
              <span>Confirm new password</span>
              <input name="confirm_password" type="password" autocomplete="new-password" minlength="15" maxlength="128" required />
            </label>
            <button class="primary-button" type="submit">Set new password</button>
            <p class="login-boundary"><strong>First-login requirement.</strong> Updating the password revokes every dashboard session for this user, then asks you to sign in again.</p>
            <span data-password-status role="status" aria-live="polite"></span>
          </form>
        </section>

        <section class="service-strip" data-service-strip hidden aria-label="Service checks">
          <article>
            <span>Process</span>
            <strong data-health>Checking</strong>
            <small data-runtime>healthz</small>
          </article>
          <article>
            <span>Readiness</span>
            <strong data-readiness>Checking</strong>
            <small data-revision>readyz</small>
          </article>
          <article>
            <span>Principal</span>
            <strong data-principal>Server key</strong>
            <small data-role>adapter authority</small>
          </article>
          <button type="button" class="secondary-button" data-reconnect>Refresh service</button>
        </section>

        <div class="notice" data-service-notice role="alert" hidden></div>

        <section class="area-panel query-panel status-panel" data-area-panel="system" hidden aria-labelledby="system-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Operations / live process</p><h2 id="system-heading">System status</h2></div>
            <button class="secondary-button" type="button" data-system-refresh>Refresh status</button>
          </div>
          <div class="status-grid" data-system-status>
            <article><span>Process</span><strong data-system-health>Checking</strong><small data-system-runtime>healthz</small></article>
            <article><span>Readiness</span><strong data-system-readiness>Checking</strong><small data-system-revision>revision pending</small></article>
            <article><span>Connection</span><strong data-system-connection>Checking</strong><small data-system-endpoint>same-origin adapter</small></article>
          </div>
          <p class="panel-note">Readiness is an honest upstream signal. A 503 means the process is reachable but a configured capability still needs repair; it is not an authorization failure.</p>
        </section>

        <section class="area-panel query-panel policy-panel" data-area-panel="access" hidden aria-labelledby="access-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Administration / effective authority</p><h2 id="access-heading">Access policy</h2></div>
            <span>resolved from the authenticated principal</span>
          </div>
          <dl class="policy-details" data-access-details></dl>
          <p class="panel-note">Scopes are evaluated by the same-origin adapter before every live request. No browser-held API key is used.</p>
        </section>

        <section class="area-panel query-panel policy-panel" data-area-panel="profile" hidden aria-labelledby="profile-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Operator / private identity</p><h2 id="profile-heading">Profile</h2></div>
            <span>session-scoped, never stored in browser storage</span>
          </div>
          <dl class="policy-details" data-profile-details></dl>
          <form class="profile-password-form" data-profile-password-form>
            <div><p class="eyebrow">Credential rotation</p><h3>Change password</h3><p>Use a new password of at least 15 characters. All existing dashboard sessions will be revoked.</p></div>
            <label><span>New password</span><input name="password" type="password" minlength="15" maxlength="128" autocomplete="new-password" required /></label>
            <label><span>Confirm new password</span><input name="confirm_password" type="password" minlength="15" maxlength="128" autocomplete="new-password" required /></label>
            <button class="primary-button" type="submit">Update password</button>
            <span data-profile-password-status role="status"></span>
          </form>
          <p class="panel-note" data-profile-password-note hidden>Password changes are available only for session-authenticated operator accounts.</p>
        </section>

        <section class="area-panel query-panel" data-area-panel="releases" hidden aria-labelledby="releases-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Governance / release controls</p><h2 id="releases-heading">Release policy</h2></div>
            <button class="secondary-button" type="button" data-releases-refresh>Refresh releases</button>
          </div>
          <div class="live-output" data-releases-output><p>Refresh to load releases authorized for this principal.</p></div>
        </section>

        <section class="area-panel memories-panel" data-area-panel="memories" hidden>
          <section class="query-panel memory-controls" aria-labelledby="memory-query-heading">
            <div class="section-heading">
              <div>
                <p class="eyebrow">Memory / authorized projection</p>
                <h2 id="memory-query-heading">Memory Atlas</h2>
              </div>
              <span>read-only · live API</span>
            </div>
            <form data-memory-form>
              <fieldset class="lens-picker">
                <legend>Memory lens</legend>
                {lenses.map((lens, index) => (
                  <label>
                    <input type="radio" name="lens" value={lens.id} data-needs={lens.needs} data-scope={lens.scope} checked={index === 0} />
                    <span>{lens.label}</span>
                  </label>
                ))}
              </fieldset>
              <div class="memory-input-grid">
                <label>
                  <span>Subject ID</span>
                  <input name="subject_id" autocomplete="off" maxlength="200" placeholder="subject identity" required />
                  <small data-subject-help>Required for the selected lens.</small>
                </label>
                <label>
                  <span data-focus-label>Focus claim ID</span>
                  <input name="focus_id" autocomplete="off" maxlength="200" placeholder="claim ID" />
                  <small data-focus-help>Used only by Evidence trace.</small>
                </label>
                <label>
                  <span>Result limit</span>
                  <input name="limit" type="number" min="1" max="100" value="50" inputmode="numeric" required />
                  <small>Server limit: 1–100.</small>
                </label>
              </div>
              <div class="form-actions memory-actions">
                <button class="primary-button" type="submit" data-memory-run>Compile memory view</button>
                <span data-memory-status role="status" aria-live="polite">Enter an authorized scope to begin.</span>
              </div>
            </form>
          </section>

          <section class="atlas-workspace" aria-label="Memory result">
            <div class="result-column">
              <header class="result-header">
                <div><p class="eyebrow">Authorized projection</p><h2 data-view-title>Waiting for a live query</h2></div>
                <span data-result-count>0 records</span>
              </header>
              <div class="atlas-graph" data-atlas-graph hidden aria-label="Memory topology">
                <svg data-atlas-edges viewBox="0 0 760 280" role="img" aria-label="Authorized memory relationships"></svg>
                <div class="atlas-graph-nodes" data-atlas-nodes></div>
              </div>
              <div class="loading-state" data-memory-loading hidden aria-label="Loading memory records"><span></span><span></span><span></span></div>
              <div class="empty-state" data-memory-empty>
                <strong>No live query yet.</strong>
                <p>Run a bounded query to inspect records authorized for this principal.</p>
              </div>
              <div class="notice" data-memory-error role="alert" hidden></div>
              <div class="record-list" data-memory-records hidden></div>
            </div>
            <aside class="inspector" aria-labelledby="inspector-heading">
              <header><p class="eyebrow">Selected record</p><h2 id="inspector-heading" data-inspector-title>Nothing selected</h2></header>
              <div class="inspector-empty" data-inspector-empty>Select a returned record to inspect canonical fields and relationships.</div>
              <div data-inspector-body hidden>
                <dl data-node-fields></dl>
                <section><h3>Relationships</h3><div data-relationships></div></section>
              </div>
            </aside>
          </section>
          <section class="compile-trace" data-compile-trace hidden aria-label="Compile trace">
            <header><span>Compile trace</span><small>authorize before expand</small></header>
            <ol>
              <li><span>1</span><strong>authenticate + scope</strong><small data-trace-scope>waiting</small></li>
              <li><span>2</span><strong>resolve focus</strong><small data-trace-focus>waiting</small></li>
              <li><span>3</span><strong>hydrate + recheck</strong><small data-trace-nodes>waiting</small></li>
              <li><span>4</span><strong>apply limits</strong><small data-trace-edges>waiting</small></li>
            </ol>
            <footer><code>POST /v1/memory-views/compile</code><span>live response</span></footer>
          </section>
          <details class="metadata-panel"><summary>View metadata</summary><pre data-metadata>No live view compiled.</pre></details>
        </section>

        <section class="area-panel query-panel" data-area-panel="context" hidden aria-labelledby="context-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Context / bounded compile</p><h2 id="context-heading">Compile task-specific context</h2></div>
            <span>Authorized SQL + optional semantic candidates</span>
          </div>
          <form data-context-form>
            <div class="input-grid context-grid">
              <label><span>Subject ID</span><input name="subject_id" maxlength="200" autocomplete="off" required /></label>
              <label><span>Task</span><input name="task" maxlength="2000" autocomplete="off" required /></label>
              <label><span>Token budget</span><input name="max_tokens" type="number" min="128" max="32000" value="1200" required /></label>
              <label><span>Project ID (optional)</span><input name="project_id" maxlength="200" autocomplete="off" /></label>
            </div>
            <div class="form-actions"><button class="primary-button" type="submit">Compile context</button><span data-context-status role="status"></span></div>
          </form>
          <div class="live-output" data-context-output><p>No context compiled in this browser session.</p></div>
        </section>

        <section class="area-panel query-panel" data-area-panel="work" hidden aria-labelledby="work-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Work / collaboration state</p><h2 id="work-heading">Leases, handoffs, and checkpoints</h2></div>
            <button class="secondary-button" type="button" data-work-refresh>Refresh work</button>
          </div>
          <form class="inline-form" data-checkpoint-form>
            <label><span>Subject ID</span><input name="subject_id" maxlength="200" autocomplete="off" required /></label>
            <label><span>Agent ID</span><input name="agent_id" maxlength="200" autocomplete="off" required /></label>
            <label><span>Kind</span><input name="kind" maxlength="100" autocomplete="off" required /></label>
            <button class="secondary-button" type="submit">Find checkpoint</button>
          </form>
          <div class="live-output" data-work-output><p>Refresh to load the work contracts available to this principal.</p></div>
        </section>

        <section class="area-panel query-panel" data-area-panel="audit" hidden aria-labelledby="audit-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Audit / metadata activity</p><h2 id="audit-heading">Audit log and domain events</h2></div>
            <button class="secondary-button" type="button" data-audit-refresh>Refresh activity</button>
          </div>
          <form class="inline-form" data-audit-form>
            <label><span>Audit action (optional)</span><input name="action" maxlength="200" autocomplete="off" /></label>
            <label><span>Event kind (optional)</span><input name="kind" maxlength="200" autocomplete="off" /></label>
            <label><span>Limit</span><input name="limit" type="number" min="1" max="200" value="50" required /></label>
          </form>
          <div class="live-output" data-audit-output><p>Refresh to reconstruct authorized metadata activity.</p></div>
        </section>

        <section class="area-panel query-panel" data-area-panel="governance" hidden aria-labelledby="governance-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Governance / access and releases</p><h2 id="governance-heading">Policies, approvals, releases, and users</h2></div>
            <button class="secondary-button" type="button" data-governance-refresh>Refresh governance</button>
          </div>
          <section class="user-admin" data-user-admin hidden aria-labelledby="add-user-heading">
            <div><h3 id="add-user-heading">Add a human user</h3><p>Creates one account and organization membership atomically. Titen generates a one-time temporary password; API keys remain for agents and services.</p></div>
            <form data-user-form>
              <label><span>Username</span><input name="username" maxlength="64" pattern="[a-z0-9][a-z0-9._-]{2,63}" autocomplete="off" autocapitalize="none" spellcheck="false" required placeholder="new.operator" /></label>
              <label><span>Role</span><select name="role" required><option>reader</option><option>member</option><option>admin</option><option data-owner-role>owner</option></select></label>
              <label><span>Access profile</span><select name="profile" required><option value="reader">Read dashboard</option><option value="operator">Memory operator</option><option value="admin">Administrator</option></select></label>
              <label><span>Trust ceiling</span><select name="max_trust" required><option>asserted</option><option>verified</option><option>policy_approved</option><option>unverified</option></select></label>
              <button class="primary-button" type="submit">Create user</button>
              <span data-user-status role="status"></span>
              <section class="one-time-credential" data-user-credential hidden aria-label="Temporary password">
                <div><strong>Temporary password</strong><span>Shown once · first login must replace it</span></div>
                <code data-user-temporary-password></code>
                <button class="secondary-button" type="button" data-copy-temporary-password>Copy password</button>
              </section>
            </form>
          </section>
          <div class="live-output" data-governance-output><p>Refresh to load the governance contracts available to this principal.</p></div>
        </section>

        <section class="area-panel query-panel" data-area-panel="federation" hidden aria-labelledby="federation-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Federation / signed peers</p><h2 id="federation-heading">Peers and exchange log</h2></div>
            <button class="secondary-button" type="button" data-federation-refresh>Refresh peers</button>
          </div>
          <form class="inline-form" data-federation-form>
            <label><span>Peer ID</span><input name="peer_id" maxlength="200" autocomplete="off" required /></label>
            <label><span>Log limit</span><input name="limit" type="number" min="1" max="200" value="50" required /></label>
            <button class="secondary-button" type="submit">Load peer log</button>
          </form>
          <div class="live-output" data-federation-output><p>Refresh to load peers registered by this principal.</p></div>
        </section>

        <dialog class="search-dialog" data-search-dialog aria-labelledby="search-heading">
          <form method="dialog" data-search-form>
            <header><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-search"></use></svg><h2 id="search-heading">Search memory</h2><button class="dialog-close" value="cancel" aria-label="Close search">Esc</button></header>
            <label><span>Subject or focus ID</span><input name="query" autocomplete="off" placeholder="platform-team or claim ID" /></label>
            <p>Search stays inside the authorized compile flow. Submitting fills the Atlas scope field; the server remains the source of truth.</p>
            <footer><button class="secondary-button" value="cancel">Cancel</button><button class="primary-button" value="default">Use in Atlas</button></footer>
          </form>
        </dialog>
      </main>
    </div>

    <script>
      import {
        DashboardApiError,
        changePassword,
        checkService,
        compileView,
        getArea,
        getDashboardStatus,
        getSession,
        login,
        logout,
        postArea,
        type AtlasNode,
        type AtlasView,
        type DashboardPrincipal,
        type DashboardStatus,
      } from "../../lib/dashboard-api";

      const one = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
      const all = <T extends Element>(selector: string) => [...document.querySelectorAll<T>(selector)];
      const memoryForm = one<HTMLFormElement>("[data-memory-form]");
      const memoryRun = one<HTMLButtonElement>("[data-memory-run]");
      const memoryRecords = one<HTMLElement>("[data-memory-records]");
      const memoryEmpty = one<HTMLElement>("[data-memory-empty]");
      const memoryLoading = one<HTMLElement>("[data-memory-loading]");
      const memoryError = one<HTMLElement>("[data-memory-error]");
      const atlasGraph = one<HTMLElement>("[data-atlas-graph]");
      const atlasEdges = one<SVGElement>("[data-atlas-edges]");
      const atlasNodes = one<HTMLElement>("[data-atlas-nodes]");
      const compileTrace = one<HTMLElement>("[data-compile-trace]");
      const searchDialog = one<HTMLDialogElement>("[data-search-dialog]");
      const searchForm = one<HTMLFormElement>("[data-search-form]");
      let view: AtlasView | null = null;
      let principal: DashboardPrincipal | null = null;
      let dashboardStatus: DashboardStatus | null = null;
      let generation = 0;

      const text = (selector: string, value: string) => { one<HTMLElement>(selector).textContent = value; };
      const has = (scope: string) => Boolean(principal?.scopes.includes("*") || principal?.scopes.includes(scope));
      function payloadData(payload: Record<string, unknown>): Record<string, unknown> {
        return payload.data && typeof payload.data === "object" && !Array.isArray(payload.data)
          ? payload.data as Record<string, unknown> : payload;
      }
      function serviceDetail(payload: Record<string, unknown>, key: string): string | undefined {
        const value = payloadData(payload)[key];
        if (typeof value === "string") return value;
        const meta = payload.meta;
        const metaValue = meta && typeof meta === "object" && !Array.isArray(meta)
          ? (meta as Record<string, unknown>)[key] : undefined;
        return typeof metaValue === "string" ? metaValue : undefined;
      }
      function renderPrincipalDetails(selector: string) {
        const target = one<HTMLDListElement>(selector);
        target.replaceChildren();
        if (!principal) return;
        for (const [label, value] of [
          ["Principal", principal.principal_id], ["Type", principal.principal_kind],
          ["Organization", principal.organization_id], ["Role", principal.organization_role ?? "none"],
          ["Trust ceiling", principal.max_trust], ["Scopes", principal.scopes.join(", ") || "none"],
        ] as const) {
          const term = document.createElement("dt");
          const description = document.createElement("dd");
          term.textContent = label;
          description.textContent = value;
          target.append(term, description);
        }
      }
      function renderAccessPolicy() {
        renderPrincipalDetails("[data-access-details]");
        renderPrincipalDetails("[data-profile-details]");
      }
      function setNotice(element: HTMLElement, message?: string) {
        element.hidden = !message;
        element.textContent = message ?? "";
      }
      function errorMessage(error: unknown): string {
        if (error instanceof DashboardApiError) {
          if (error.status === 401) return "Your dashboard session is no longer valid. Sign in again.";
          if (error.status === 403) return "This principal is not authorized for that operation.";
          if (error.status === 404) return "The authorized resource was not found.";
          if (error.status === 503) return "Titen is not ready. Inspect readiness before retrying.";
          return error.message;
        }
        return "The same-origin dashboard adapter is unreachable.";
      }
      function handleError(error: unknown, target?: HTMLElement) {
        if (error instanceof DashboardApiError && error.status === 401 && dashboardStatus?.authentication === "session") signedOut(errorMessage(error));
        else if (target) renderMessage(target, errorMessage(error), true);
        else setNotice(one("[data-service-notice]"), errorMessage(error));
      }

      function renderMessage(target: HTMLElement, message: string, danger = false) {
        target.replaceChildren();
        const paragraph = document.createElement("p");
        paragraph.textContent = message;
        if (danger) paragraph.className = "output-error";
        target.append(paragraph);
      }
      function rowLabel(row: Record<string, unknown>, index: number): string {
        for (const key of ["label", "statement", "name", "action", "kind", "principal_id", "peer_id", "lease_id", "handoff_id", "event_id", "membership_id", "policy_id", "release_id", "key_id", "id", "status"])
          if (typeof row[key] === "string" && row[key]) return String(row[key]);
        return `Record ${index + 1}`;
      }
      function renderPayload(target: HTMLElement, payload: Record<string, unknown>) {
        target.replaceChildren();
        const data = payloadData(payload);
        const arrays = Object.entries(data).filter((entry): entry is [string, unknown[]] => Array.isArray(entry[1]));
        if (!arrays.length) {
          const pre = document.createElement("pre");
          pre.textContent = JSON.stringify(data, null, 2);
          target.append(pre);
          return;
        }
        for (const [name, rows] of arrays) {
          const section = document.createElement("section");
          const heading = document.createElement("h3");
          heading.textContent = `${name.replaceAll("_", " ")} · ${rows.length}`;
          section.append(heading);
          if (!rows.length) {
            const empty = document.createElement("p");
            empty.textContent = "No authorized records returned.";
            section.append(empty);
          }
          rows.slice(0, 200).forEach((value, index) => {
            const row = value && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : { value };
            const details = document.createElement("details");
            const summary = document.createElement("summary");
            const pre = document.createElement("pre");
            summary.textContent = rowLabel(row, index);
            pre.textContent = JSON.stringify(row, null, 2);
            details.append(summary, pre);
            section.append(details);
          });
          target.append(section);
        }
        const metadata = Object.fromEntries(Object.entries(data).filter(([, value]) => !Array.isArray(value)));
        if (Object.keys(metadata).length) {
          const details = document.createElement("details");
          const summary = document.createElement("summary");
          const pre = document.createElement("pre");
          summary.textContent = "Response metadata";
          pre.textContent = JSON.stringify(metadata, null, 2);
          details.append(summary, pre);
          target.append(details);
        }
      }
      async function loadAvailable(target: HTMLElement, requests: Array<[string, string]>) {
        renderMessage(target, "Loading authorized live data…");
        const selected = requests.filter(([, scope]) => has(scope));
        if (!selected.length) return renderMessage(target, "This principal has no read capability for this area.");
        const results = await Promise.all(selected.map(async ([path]) => [path.split("/").at(-1)!, await getArea(path)] as const));
        const merged: Record<string, unknown> = {};
        for (const [name, payload] of results) Object.assign(merged, payloadData(payload));
        renderPayload(target, { data: merged });
      }

      function clearMemory() {
        generation += 1;
        view = null;
        memoryRecords.replaceChildren();
        memoryRecords.hidden = true;
        atlasGraph.hidden = true;
        atlasEdges.replaceChildren();
        atlasNodes.replaceChildren();
        compileTrace.hidden = true;
        memoryLoading.hidden = true;
        memoryEmpty.hidden = false;
        memoryEmpty.querySelector("strong")!.textContent = "No live query yet.";
        memoryEmpty.querySelector("p")!.textContent = "Run a bounded query to inspect records authorized for this principal.";
        text("[data-view-title]", "Waiting for a live query");
        text("[data-result-count]", "0 records");
        text("[data-metadata]", "No live view compiled.");
        text("[data-memory-status]", "Enter an authorized scope to begin.");
        setNotice(memoryError);
        text("[data-inspector-title]", "Nothing selected");
        one<HTMLElement>("[data-inspector-empty]").hidden = false;
        one<HTMLElement>("[data-inspector-body]").hidden = true;
        one<HTMLDListElement>("[data-node-fields]").replaceChildren();
        one<HTMLElement>("[data-relationships]").replaceChildren();
      }
      function clearPrivateState() {
        clearMemory();
        one<HTMLDListElement>("[data-access-details]").replaceChildren();
        one<HTMLDListElement>("[data-profile-details]").replaceChildren();
        one<HTMLFormElement>("[data-profile-password-form]").reset();
        text("[data-profile-password-status]", "");
        one<HTMLElement>("[data-user-credential]").hidden = true;
        text("[data-user-temporary-password]", "");
        for (const selector of ["[data-context-output]", "[data-work-output]", "[data-audit-output]", "[data-governance-output]", "[data-federation-output]"])
          renderMessage(one(selector), "No live data loaded for this principal.");
      }
      function updateMemoryRequirements() {
        const selected = one<HTMLInputElement>('input[name="lens"]:checked');
        const subject = memoryForm.elements.namedItem("subject_id") as HTMLInputElement;
        const focus = memoryForm.elements.namedItem("focus_id") as HTMLInputElement;
        const lens = selected.value;
        subject.required = selected.dataset.needs === "subject";
        focus.required = selected.dataset.needs === "focus";
        text("[data-subject-help]", subject.required ? "Required for the selected lens." : lens === "review_queue" ? "Optional review filter." : "Not used by this lens.");
        const copy = lens === "evidence_trace" ? ["Focus claim ID", "claim ID", "Required for Evidence trace."]
          : lens === "scope_preview" ? ["Focus principal ID", "principal ID", "Required for Scope preview."]
          : lens === "knowledge_release" ? ["Focus channel ID", "optional channel ID", "Optional channel filter."]
          : ["Focus ID", "not used", "Not used by this lens."];
        text("[data-focus-label]", copy[0]);
        focus.placeholder = copy[1];
        text("[data-focus-help]", copy[2]);
      }
      function formatDate(value: string, detailed = false): string | undefined {
        const date = new Date(value);
        return Number.isNaN(date.valueOf()) ? undefined : detailed ? date.toLocaleString() : date.toLocaleDateString();
      }
      function addField(list: HTMLDListElement, label: string, value: unknown) {
        if (value === undefined || value === null || value === "") return;
        const term = document.createElement("dt");
        const description = document.createElement("dd");
        term.textContent = label;
        description.textContent = Array.isArray(value) ? value.join(", ") || "none" : String(value);
        list.append(term, description);
      }
      function inspect(node: AtlasNode) {
        memoryRecords.querySelectorAll("button").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.id === node.id)));
        text("[data-inspector-title]", node.label);
        one<HTMLElement>("[data-inspector-empty]").hidden = true;
        one<HTMLElement>("[data-inspector-body]").hidden = false;
        const fields = one<HTMLDListElement>("[data-node-fields]");
        fields.replaceChildren();
        for (const [label, value] of [
          ["ID", node.id], ["Type", node.type], ["Trust", node.trust], ["Status", node.status],
          ["Created", formatDate(node.created_at, true)], ["Freshness", node.freshness === undefined ? undefined : `${node.freshness} days`],
          ["Confidence", node.confidence], ["Priority", node.priority], ["Reasons", node.reasons], ["Owner", node.owner_id],
          ["Next action", node.next_action], ["Deadline", node.deadline], ["Evidence refs", node.evidence_refs], ["Audit refs", node.audit_refs],
        ] as const) addField(fields, label, value);
        const relationships = one<HTMLElement>("[data-relationships]");
        relationships.replaceChildren();
        const edges = view?.edges.filter((edge) => edge.from === node.id || edge.to === node.id) ?? [];
        if (!edges.length) relationships.textContent = "No relationships returned in this view.";
        for (const edge of edges) {
          const row = document.createElement("p");
          row.textContent = `${edge.from} — ${edge.relation} → ${edge.to}`;
          relationships.append(row);
        }
      }
      function renderGraph(next: AtlasView) {
        atlasEdges.replaceChildren();
        atlasNodes.replaceChildren();
        if (!next.nodes.length) { atlasGraph.hidden = true; return; }
        atlasGraph.hidden = false;
        const positions = next.nodes.map((_, index) => ({
          x: 126 + (index % 3) * 254,
          y: 58 + Math.floor(index / 3) * 104,
        }));
        const byId = new Map(next.nodes.map((node, index) => [node.id, positions[index]]));
        for (const edge of next.edges) {
          const from = byId.get(edge.from);
          const to = byId.get(edge.to);
          if (!from || !to) continue;
          const line = document.createElementNS("http://www.w3.org/2000/svg", "path");
          line.setAttribute("d", `M ${from.x} ${from.y} C ${(from.x + to.x) / 2} ${from.y}, ${(from.x + to.x) / 2} ${to.y}, ${to.x} ${to.y}`);
          line.setAttribute("fill", "none");
          line.setAttribute("stroke", "#171310");
          line.setAttribute("stroke-width", "1.5");
          line.setAttribute("stroke-opacity", ".45");
          atlasEdges.append(line);
        }
        for (const node of next.nodes) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "atlas-node";
          button.dataset.id = node.id;
          button.setAttribute("aria-pressed", "false");
          const kind = document.createElement("span");
          kind.className = "node-kind";
          kind.textContent = node.type;
          const label = document.createElement("strong");
          label.textContent = node.label;
          const detail = document.createElement("small");
          detail.textContent = [node.trust, node.status, formatDate(node.created_at)].filter(Boolean).join(" · ");
          button.append(kind, label, detail);
          button.addEventListener("click", () => inspect(node));
          atlasNodes.append(button);
        }
      }
      function renderMemory(next: AtlasView) {
        view = next;
        renderGraph(next);
        memoryRecords.replaceChildren();
        text("[data-view-title]", next.lens.replaceAll("_", " "));
        text("[data-result-count]", `${next.nodes.length} records · ${next.edges.length} edges`);
        text("[data-metadata]", JSON.stringify(next.metadata, null, 2));
        compileTrace.hidden = false;
        text("[data-trace-scope]", typeof next.metadata.subject_id === "string" ? next.metadata.subject_id : "authorized");
        text("[data-trace-focus]", next.focus_id ?? "lens root");
        text("[data-trace-nodes]", `${next.nodes.length} current`);
        text("[data-trace-edges]", `${next.edges.length} returned`);
        memoryEmpty.hidden = next.nodes.length > 0;
        if (!next.nodes.length) {
          memoryEmpty.querySelector("strong")!.textContent = "No authorized records found.";
          memoryEmpty.querySelector("p")!.textContent = "The live query succeeded. Adjust its bounded scope if you expected data.";
        }
        memoryRecords.hidden = next.nodes.length === 0;
        for (const node of next.nodes) {
          const button = document.createElement("button");
          const kind = document.createElement("span");
          const label = document.createElement("strong");
          const detail = document.createElement("small");
          button.type = "button";
          button.dataset.id = node.id;
          button.setAttribute("aria-pressed", "false");
          kind.textContent = node.type;
          kind.className = "record-kind";
          label.textContent = node.label;
          detail.textContent = [node.trust, node.status, formatDate(node.created_at)].filter(Boolean).join(" · ");
          button.append(kind, label, detail);
          button.addEventListener("click", () => inspect(node));
          memoryRecords.append(button);
        }
        if (next.nodes[0]) inspect(next.nodes[0]);
      }

      function accessible(button: HTMLButtonElement): boolean {
        if (button.dataset.area === "system") return true;
        const scopes = button.dataset.scopes?.split(" ") ?? [];
        return scopes.some(has);
      }
      function activateArea(id: string, source?: HTMLButtonElement) {
        for (const panel of all<HTMLElement>("[data-area-panel]")) panel.hidden = panel.dataset.areaPanel !== id;
        const selected = source ?? all<HTMLButtonElement>("[data-area]").find((button) => button.dataset.area === id && !button.hidden);
        for (const button of all<HTMLButtonElement>("[data-area]")) button.setAttribute("aria-current", button === selected ? "page" : "false");
        one<HTMLButtonElement>("[data-profile-open]").setAttribute("aria-current", id === "profile" ? "page" : "false");
        const label = selected?.dataset.label ?? (id === "profile" ? "Profile" : "Dashboard");
        text("[data-page-title]", label);
        text("[data-breadcrumb-area]", id === "memories" ? "Memory" : "Operator");
        text("[data-breadcrumb-page]", label);
        history.replaceState(null, "", `#${id}`);
      }
      function showPrivateSurface() {
        one<HTMLElement>(".app-shell").dataset.shell = "private";
        one<HTMLElement>("[data-login-panel]").hidden = true;
        one<HTMLElement>("[data-service-strip]").hidden = false;
        one<HTMLElement>("[data-product-nav]").hidden = false;
        one<HTMLButtonElement>("[data-profile-open]").hidden = false;
        const buttons = all<HTMLButtonElement>("[data-area]");
        for (const button of buttons) button.hidden = !accessible(button);
        for (const input of all<HTMLInputElement>('[data-memory-form] input[name="lens"]')) {
          const allowed = !input.dataset.scope || has(input.dataset.scope);
          input.disabled = !allowed;
          input.closest("label")!.hidden = !allowed;
        }
        const selectedLens = one<HTMLInputElement>('[data-memory-form] input[name="lens"]:checked');
        if (selectedLens.disabled) all<HTMLInputElement>('[data-memory-form] input[name="lens"]:not(:disabled)')[0]?.click();
        const preferred = location.hash.slice(1);
        const first = buttons.find((button) => !button.hidden && button.dataset.area === preferred)
          ?? buttons.find((button) => !button.hidden);
        if (first) activateArea(first.dataset.area!);
        one<HTMLButtonElement>("[data-logout]").hidden = dashboardStatus?.authentication !== "session";
        const profileName = principal?.principal_id ?? "server-key";
        text("[data-profile-name]", profileName);
        text("[data-profile-role]", principal ? `${principal.organization_role ?? "no org role"} · ${principal.principal_kind}` : "adapter authority");
        text("[data-profile-avatar]", profileName.slice(0, 2).toUpperCase());
        one<HTMLFormElement>("[data-profile-password-form]").hidden = dashboardStatus?.authentication !== "session";
        one<HTMLElement>("[data-profile-password-note]").hidden = dashboardStatus?.authentication === "session";
        one<HTMLElement>("[data-user-admin]").hidden = !(dashboardStatus?.authentication === "session"
          && has("keys:manage") && has("memberships:write")
          && ["root", "owner", "admin"].includes(String(principal?.organization_role)));
        one<HTMLOptionElement>("[data-owner-role]").disabled = !["root", "owner"].includes(String(principal?.organization_role));
      }
      function showLoginSurface() {
        clearPrivateState();
        one<HTMLElement>(".app-shell").dataset.shell = "login";
        for (const panel of all<HTMLElement>("[data-area-panel]")) panel.hidden = true;
        for (const button of all<HTMLButtonElement>("[data-area]")) button.hidden = true;
        one<HTMLElement>("[data-product-nav]").hidden = true;
        one<HTMLElement>("[data-service-strip]").hidden = true;
        one<HTMLButtonElement>("[data-profile-open]").hidden = true;
        one<HTMLButtonElement>("[data-logout]").hidden = true;
        one<HTMLElement>("[data-login-panel]").hidden = false;
        text("[data-page-title]", "Sign in");
        text("[data-connection-label]", "Authentication required");
        text("[data-principal]", "Not signed in");
        text("[data-role]", "no active session");
      }
      function signedOut(message?: string) {
        principal = null;
        showLoginSurface();
        one<HTMLFormElement>("[data-login-form]").hidden = false;
        one<HTMLFormElement>("[data-password-form]").hidden = true;
        one<HTMLFormElement>("[data-password-form]").reset();
        text("[data-login-heading]", "Sign in");
        text("[data-login-copy]", "Use the operator account issued by your Titen organization.");
        text("[data-login-status]", message ?? "");
        text("[data-password-status]", "");
      }
      function showPasswordChange() {
        showLoginSurface();
        one<HTMLFormElement>("[data-login-form]").hidden = true;
        one<HTMLFormElement>("[data-password-form]").hidden = false;
        text("[data-login-heading]", "Set a new password");
        text("[data-login-copy]", "Replace the temporary password before accessing organization data.");
        text("[data-password-status]", "");
      }
      async function refreshService() {
        const notice = one<HTMLElement>("[data-service-notice]");
        setNotice(notice);
        text("[data-connection-label]", "Connecting");
        one<HTMLElement>("[data-connection-dot]").className = "";
        try {
          dashboardStatus = await getDashboardStatus();
          if (dashboardStatus.mode !== "live") throw new DashboardApiError(503, "DASHBOARD_DISCONNECTED", "Live dashboard integration is disabled.");
          text("[data-endpoint]", dashboardStatus.endpoint ?? "configured endpoint");
          text("[data-credential-mode]", dashboardStatus.authentication === "session" ? "Per-principal session" : "Server key");
          text("[data-credential-copy]", dashboardStatus.authentication === "session"
            ? "The password is verified once; a short-lived API key stays only in adapter memory."
            : "The browser uses a bounded server-side adapter key.");
          if (dashboardStatus.authentication === "session" && !dashboardStatus.authenticated) return signedOut();
          principal = await getSession();
          if (principal.password_change_required) return showPasswordChange();
          showPrivateSurface();
          renderAccessPolicy();
          text("[data-principal]", principal?.principal_id ?? "Server key");
          text("[data-role]", principal ? `${principal.organization_role ?? "no org role"} · ${principal.principal_kind}` : "adapter authority");
          const [health, readiness] = await Promise.all([checkService("health"), checkService("readiness")]);
          const healthLabel = health.ok ? serviceDetail(health.payload, "status") ?? "Healthy" : `Error ${health.status}`;
          const runtimeLabel = serviceDetail(health.payload, "runtime") ?? "healthz";
          const readinessLabel = readiness.ok ? "Ready" : `Not ready · ${readiness.status}`;
          const revisionLabel = serviceDetail(readiness.payload, "revision") ?? serviceDetail(health.payload, "revision") ?? "revision unavailable";
          const connectionLabel = health.ok ? "Connected" : "Degraded";
          text("[data-health]", healthLabel);
          text("[data-runtime]", runtimeLabel);
          text("[data-readiness]", readinessLabel);
          text("[data-revision]", revisionLabel);
          text("[data-connection-label]", connectionLabel);
          text("[data-system-health]", healthLabel);
          text("[data-system-runtime]", runtimeLabel);
          text("[data-system-readiness]", readinessLabel);
          text("[data-system-revision]", revisionLabel);
          text("[data-system-connection]", connectionLabel);
          text("[data-system-endpoint]", dashboardStatus.endpoint ?? "same-origin adapter");
          one<HTMLElement>("[data-connection-dot]").className = health.ok && readiness.ok ? "ok" : "warn";
          setNotice(notice, readiness.ok ? undefined : "The process is reachable but not ready. Product requests may fail until readiness recovers.");
        } catch (error) {
          if (error instanceof DashboardApiError && error.status === 401
            && dashboardStatus?.authentication === "session") return signedOut(errorMessage(error));
          clearPrivateState();
          text("[data-connection-label]", "Disconnected");
          text("[data-endpoint]", "same-origin adapter unavailable");
          one<HTMLElement>("[data-connection-dot]").className = "bad";
          setNotice(notice, dashboardStatus ? errorMessage(error) : "The same-origin dashboard adapter is unavailable.");
        }
      }

      const readerScopes = ["views:compile", "context:compile", "evidence:read", "checkpoints:read", "leases:read", "handoffs:read", "events:read", "audit:read", "governance:read", "approvals:read", "releases:read", "memberships:read", "identity:read", "federation:read", "workspaces:read"];
      const profiles: Record<string, string[]> = {
        reader: readerScopes,
        operator: [...readerScopes, "observations:write", "claims:write", "feedback:write", "checkpoints:write", "leases:write", "handoffs:write", "approvals:write", "releases:write"],
        admin: [...readerScopes, "observations:write", "claims:write", "feedback:write", "checkpoints:write", "leases:write", "handoffs:write", "keys:manage", "memberships:write", "workspaces:write", "governance:write", "approvals:write", "approvals:approve", "releases:write", "releases:approve", "retention:write", "identity:write", "federation:write", "webhooks:read", "webhooks:write", "export:read", "import:write"],
      };
      for (const button of all<HTMLButtonElement>("[data-area]")) button.addEventListener("click", () => activateArea(button.dataset.area!, button));
      one<HTMLFormElement>("[data-login-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const username = form.elements.namedItem("username") as HTMLInputElement;
        const password = form.elements.namedItem("password") as HTMLInputElement;
        text("[data-login-status]", "Signing in…");
        try {
          principal = await login(username.value, password.value);
          password.value = "";
          await refreshService();
        } catch (error) {
          password.value = "";
          text("[data-login-status]", errorMessage(error));
        }
      });
      one<HTMLFormElement>("[data-password-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const password = form.elements.namedItem("password") as HTMLInputElement;
        const confirm = form.elements.namedItem("confirm_password") as HTMLInputElement;
        if (password.value !== confirm.value) return text("[data-password-status]", "Passwords do not match.");
        text("[data-password-status]", "Updating password…");
        try {
          await changePassword(password.value);
          signedOut("Password updated. Sign in with your new password.");
        } catch (error) {
          password.value = "";
          confirm.value = "";
          text("[data-password-status]", errorMessage(error));
        }
      });
      one<HTMLButtonElement>("[data-logout]").addEventListener("click", async () => {
        try {
          await logout();
          signedOut("Signed out. The adapter discarded this browser session.");
        } catch (error) { handleError(error); }
      });
      one<HTMLButtonElement>("[data-profile-open]").addEventListener("click", () => activateArea("profile"));
      one<HTMLFormElement>("[data-profile-password-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const password = form.elements.namedItem("password") as HTMLInputElement;
        const confirm = form.elements.namedItem("confirm_password") as HTMLInputElement;
        if (password.value !== confirm.value) return text("[data-profile-password-status]", "Passwords do not match.");
        text("[data-profile-password-status]", "Updating password…");
        try {
          await changePassword(password.value);
          signedOut("Password updated. Sign in with your new password.");
        } catch (error) {
          password.value = "";
          confirm.value = "";
          text("[data-profile-password-status]", errorMessage(error));
        }
      });
      one<HTMLButtonElement>("[data-reconnect]").addEventListener("click", refreshService);
      one<HTMLButtonElement>("[data-system-refresh]").addEventListener("click", refreshService);
      one<HTMLButtonElement>("[data-search-open]").addEventListener("click", () => {
        searchDialog.showModal();
        (searchForm.elements.namedItem("query") as HTMLInputElement).focus();
      });
      searchForm.addEventListener("submit", (event) => {
        const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
        if (submitter?.value !== "default") return;
        event.preventDefault();
        const query = String(new FormData(searchForm).get("query") ?? "").trim();
        const subject = memoryForm.elements.namedItem("subject_id") as HTMLInputElement;
        if (query) subject.value = query;
        searchDialog.close();
        activateArea("memories");
        subject.focus();
      });
      document.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          if (!searchDialog.open) one<HTMLButtonElement>("[data-search-open]").click();
        }
      });

      memoryForm.addEventListener("change", (event) => {
        if ((event.target as HTMLInputElement).name === "lens") updateMemoryRequirements();
      });
      memoryForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!memoryForm.reportValidity()) return;
        const values = new FormData(memoryForm);
        const payload: Record<string, unknown> = { lens: String(values.get("lens")), limit: Number(values.get("limit")) };
        const subject = String(values.get("subject_id") ?? "").trim();
        const focus = String(values.get("focus_id") ?? "").trim();
        if (subject) payload.subject_id = subject;
        if (focus) payload.focus_id = focus;
        clearMemory();
        const current = generation;
        memoryLoading.hidden = false;
        memoryEmpty.hidden = true;
        memoryRun.disabled = true;
        text("[data-memory-status]", "Compiling authorized memory view…");
        try {
          const next = await compileView(payload);
          if (current !== generation) return;
          renderMemory(next);
          text("[data-memory-status]", "Live view compiled from the Titen API.");
        } catch (error) {
          if (current !== generation) return;
          clearMemory();
          setNotice(memoryError, errorMessage(error));
          handleError(error);
        } finally { memoryLoading.hidden = true; memoryRun.disabled = false; }
      });

      one<HTMLFormElement>("[data-context-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const values = new FormData(form);
        const body: Record<string, unknown> = {
          subject_id: String(values.get("subject_id")).trim(),
          task: String(values.get("task")).trim(),
          max_tokens: Number(values.get("max_tokens")),
        };
        const project = String(values.get("project_id") ?? "").trim();
        if (project) body.project_id = project;
        const target = one<HTMLElement>("[data-context-output]");
        renderMessage(target, "Compiling authorized context…");
        try { renderPayload(target, await postArea("context/compile", body)); text("[data-context-status]", "Live context compiled."); }
        catch (error) { handleError(error, target); }
      });
      one<HTMLButtonElement>("[data-work-refresh]").addEventListener("click", async () => {
        try { await loadAvailable(one("[data-work-output]"), [["work/leases?limit=50", "leases:read"], ["work/handoffs", "handoffs:read"]]); }
        catch (error) { handleError(error, one("[data-work-output]")); }
      });
      one<HTMLFormElement>("[data-checkpoint-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const values = new FormData(form);
        const query = new URLSearchParams();
        for (const field of ["subject_id", "agent_id", "kind"]) query.set(field, String(values.get(field)).trim());
        const target = one<HTMLElement>("[data-work-output]");
        try { renderPayload(target, await getArea("work/checkpoint", query)); } catch (error) { handleError(error, target); }
      });
      one<HTMLButtonElement>("[data-audit-refresh]").addEventListener("click", async () => {
        const values = new FormData(one<HTMLFormElement>("[data-audit-form]"));
        const limit = String(values.get("limit"));
        const requests: Array<[string, string]> = [];
        const action = String(values.get("action") ?? "").trim();
        const kind = String(values.get("kind") ?? "").trim();
        requests.push([`audit/log?limit=${encodeURIComponent(limit)}${action ? `&action=${encodeURIComponent(action)}` : ""}`, "audit:read"]);
        requests.push([`audit/events?limit=${encodeURIComponent(limit)}${kind ? `&kind=${encodeURIComponent(kind)}` : ""}`, "events:read"]);
        try { await loadAvailable(one("[data-audit-output]"), requests); } catch (error) { handleError(error, one("[data-audit-output]")); }
      });
      one<HTMLButtonElement>("[data-governance-refresh]").addEventListener("click", async () => {
        try {
          await loadAvailable(one("[data-governance-output]"), [
            ["governance/memberships", "memberships:read"], ["governance/keys", "keys:manage"],
            ["governance/policies", "governance:read"], ["governance/approvals", "approvals:read"],
            ["governance/channels", "releases:read"], ["governance/releases", "releases:read"],
          ]);
        } catch (error) { handleError(error, one("[data-governance-output]")); }
      });
      one<HTMLFormElement>("[data-user-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const values = new FormData(form);
        const profile = String(values.get("profile"));
        text("[data-user-status]", "Creating account and membership atomically…");
        try {
          const response = await postArea("governance/users", {
            username: String(values.get("username")).trim().toLowerCase(),
            role: String(values.get("role")),
            scopes: profiles[profile]!,
            max_trust: String(values.get("max_trust")),
          });
          const data = payloadData(response);
          if (typeof data.temporary_password !== "string")
            throw new DashboardApiError(502, "INVALID_UPSTREAM_RESPONSE", "Titen did not return the one-time password.");
          form.reset();
          text("[data-user-temporary-password]", data.temporary_password);
          one<HTMLElement>("[data-user-credential]").hidden = false;
          text("[data-user-status]", `Created ${data.username} with role ${data.role}. Copy the temporary password now.`);
        } catch (error) { text("[data-user-status]", errorMessage(error)); handleError(error); }
      });
      one<HTMLButtonElement>("[data-copy-temporary-password]").addEventListener("click", async () => {
        const value = one<HTMLElement>("[data-user-temporary-password]").textContent ?? "";
        try {
          await navigator.clipboard.writeText(value);
          text("[data-user-status]", "Temporary password copied.");
        } catch { text("[data-user-status]", "Copy failed. Select the temporary password manually."); }
      });
      one<HTMLButtonElement>("[data-federation-refresh]").addEventListener("click", async () => {
        const target = one<HTMLElement>("[data-federation-output]");
        try { renderPayload(target, await getArea("federation/peers")); } catch (error) { handleError(error, target); }
      });
      one<HTMLFormElement>("[data-federation-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const values = new FormData(event.currentTarget as HTMLFormElement);
        const query = new URLSearchParams({ peer_id: String(values.get("peer_id")).trim(), limit: String(values.get("limit")) });
        const target = one<HTMLElement>("[data-federation-output]");
        try { renderPayload(target, await getArea("federation/log", query)); } catch (error) { handleError(error, target); }
      });
      one<HTMLButtonElement>("[data-releases-refresh]").addEventListener("click", async () => {
        const target = one<HTMLElement>("[data-releases-output]");
        try { renderPayload(target, await getArea("governance/releases")); }
        catch (error) { handleError(error, target); }
      });

      updateMemoryRequirements();
      clearPrivateState();
      refreshService();
    </script>
  </body>
</html>
