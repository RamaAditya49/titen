---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/jetbrains-mono";
import "../../styles/dashboard.css";
import titenMark from "../../../docs/assets/brand/titen-mark.svg?url";
import packageJson from "../../../package.json";
import { ROUTE_INVENTORY } from "../../core/app";

const productAreas = [
  { id: "memories", label: "Memories", scopes: "views:compile" },
  { id: "context", label: "Context", scopes: "context:compile" },
  { id: "work", label: "Work", scopes: "checkpoints:read leases:read handoffs:read" },
  { id: "audit", label: "Audit", scopes: "audit:read events:read" },
  { id: "governance", label: "Governance", scopes: "governance:read approvals:read releases:read memberships:read keys:manage" },
  { id: "federation", label: "Federation", scopes: "federation:read" },
];
const lenses = [
  { id: "evidence_trace", label: "Evidence trace", needs: "focus", scope: "" },
  { id: "neighborhood", label: "Neighborhood", needs: "subject", scope: "" },
  { id: "conflict_freshness", label: "Conflict & freshness", needs: "subject", scope: "" },
  { id: "scope_preview", label: "Scope preview", needs: "focus", scope: "governance:read" },
  { id: "workspace_graph", label: "Graph", needs: "workspace", scope: "" },
  { id: "review_queue", label: "Review queue", needs: "optional", scope: "" },
  { id: "knowledge_release", label: "Knowledge releases", needs: "optional", scope: "releases:read" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Titen operator dashboard — live memory, context, work, audit, governance, and federation." />
    <title>Titen · Operator dashboard</title>
  </head>
  <body>
    <svg class="icon-sprite" aria-hidden="true" focusable="false">
      <defs>
        <symbol id="icon-observation" viewBox="0 0 100 100"><rect x="24" y="16" width="52" height="68" rx="3" fill="none" stroke="currentColor" stroke-width="6"/><path d="M36 38h28M36 52h28" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><path d="M36 66h16" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round"/></symbol>
        <symbol id="icon-claim" viewBox="0 0 100 100"><circle cx="26" cy="42" r="12" fill="currentColor"/><path d="M44 42h40M26 68h44" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"/><path d="M26 68h44" fill="none" stroke="var(--accent)" stroke-width="7" stroke-linecap="round"/></symbol>
        <symbol id="icon-context" viewBox="0 0 100 100"><circle cx="50" cy="50" r="11" fill="currentColor"/><path d="M14 34l12 12-12 12M86 34L74 46l12 12M36 84l12-12 12 12" fill="none" stroke="currentColor" stroke-width="6.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M36 84l12-12" fill="none" stroke="var(--accent)" stroke-width="6.4" stroke-linecap="round"/></symbol>
        <symbol id="icon-atlas" viewBox="0 0 100 100"><circle cx="50" cy="50" r="10" fill="var(--accent)"/><g fill="currentColor"><circle cx="20" cy="24" r="7"/><circle cx="80" cy="24" r="7"/><circle cx="20" cy="76" r="7"/><circle cx="80" cy="76" r="7"/></g><g fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity=".5"><path d="M27 29l16 15M73 29L57 44M27 71l16-15M73 71L57 56"/></g></symbol>
        <symbol id="icon-work" viewBox="0 0 100 100"><path d="M28 16v68M28 22h48L64 40l12 18H28" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="28" cy="76" r="8" fill="var(--accent)"/></symbol>
        <symbol id="icon-audit" viewBox="0 0 100 100"><g fill="currentColor"><circle cx="24" cy="30" r="5"/><circle cx="24" cy="50" r="5"/><circle cx="24" cy="70" r="5"/></g><path d="M42 30h42M42 50h42M42 70h26" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><path d="M42 70h26" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round"/></symbol>
        <symbol id="icon-system" viewBox="0 0 100 100"><path d="M10 54h20l8-22 12 42 10-20h30" fill="none" stroke="currentColor" stroke-width="6.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="icon-access" viewBox="0 0 100 100"><circle cx="34" cy="50" r="16" fill="none" stroke="currentColor" stroke-width="6.4"/><path d="M50 50h38M70 50v14M84 50v12" fill="none" stroke="var(--accent)" stroke-width="6.4" stroke-linecap="round"/></symbol>
        <symbol id="icon-governance" viewBox="0 0 100 100"><path d="M50 12l30 12v28c0 18-14 30-30 36-16-6-30-18-30-36V24z" fill="none" stroke="currentColor" stroke-width="6.4"/><path d="M36 50l11 11 19-21" fill="none" stroke="var(--accent)" stroke-width="6.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="icon-release" viewBox="0 0 100 100"><rect x="16" y="26" width="46" height="52" rx="3" fill="none" stroke="currentColor" stroke-width="6"/><path d="M62 38h26M78 28l10 10-10 10" fill="none" stroke="var(--accent)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="icon-federation" viewBox="0 0 100 100"><ellipse cx="50" cy="25" rx="15" ry="25" fill="none" stroke="currentColor" stroke-width="5"/><ellipse cx="50" cy="75" rx="15" ry="25" fill="none" stroke="currentColor" stroke-width="5"/><ellipse cx="25" cy="50" rx="25" ry="15" fill="none" stroke="currentColor" stroke-width="5"/><ellipse cx="75" cy="50" rx="25" ry="15" fill="none" stroke="currentColor" stroke-width="5"/><circle cx="50" cy="50" r="8" fill="var(--accent)"/></symbol>
        <symbol id="icon-workspace" viewBox="-4 -4 108 108"><g fill="none" stroke="currentColor" stroke-width="1.6" opacity=".28"><ellipse cx="50" cy="25" rx="15" ry="25"/><ellipse cx="50" cy="75" rx="15" ry="25"/></g><ellipse cx="25" cy="50" rx="25" ry="15" fill="currentColor" stroke="var(--paper-strong)" stroke-width="2.4"/><ellipse cx="75" cy="50" rx="25" ry="15" fill="currentColor" stroke="var(--paper-strong)" stroke-width="2.4"/><circle cx="50" cy="50" r="8.5" fill="var(--paper-strong)"/><circle cx="50" cy="50" r="4.6" fill="currentColor"/></symbol>
        <symbol id="icon-chevron" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
        <symbol id="icon-api" viewBox="0 0 100 100"><circle cx="34" cy="50" r="16" fill="none" stroke="currentColor" stroke-width="6"/><path d="M50 50h38M72 50v14M84 50v10" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><circle cx="34" cy="50" r="5" fill="var(--accent)"/></symbol>
        <symbol id="icon-model" viewBox="0 0 100 100"><rect x="26" y="26" width="48" height="48" fill="none" stroke="currentColor" stroke-width="6"/><path d="M38 14v12M62 14v12M38 74v12M62 74v12M14 38h12M14 62h12M74 38h12M74 62h12" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><circle cx="50" cy="50" r="9" fill="var(--accent)"/></symbol>
        <symbol id="icon-subject" viewBox="0 0 100 100"><circle cx="50" cy="34" r="15" fill="none" stroke="currentColor" stroke-width="6"/><path d="M22 84c0-20 12-28 28-28s28 8 28 28" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><circle cx="78" cy="26" r="7" fill="var(--accent)"/></symbol>
        <symbol id="icon-project" viewBox="0 0 100 100"><path d="M14 30h26l8 12h38v36H14z" fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round"/><path d="M24 58h50" stroke="var(--accent)" stroke-width="6" stroke-linecap="round"/></symbol>
        <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 16l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></symbol>
        <symbol id="icon-disconnect" viewBox="0 0 24 24"><path d="M9 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h3M13 12h8M17 8l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol>
      </defs>
    </svg>
    <a class="skip-link" href="#workspace">Skip to workspace</a>
    <div class="app-shell" data-shell="loading">
      <aside class="sidebar" aria-label="Product areas">
        <header class="brand-row">
          <img src={titenMark} width="24" height="24" alt="" />
          <strong>titen</strong>
          <span>v{packageJson.version}</span>
        </header>

        <div class="workspace-picker" data-workspace-control hidden>
          <details data-workspace-menu>
            <summary aria-label="Select active workspace">
              <span class="workspace-trigger-copy">
                <svg viewBox="-4 -4 108 108" aria-hidden="true"><use href="#icon-workspace"></use></svg>
                <span><strong data-workspace-label>Unscoped memory</strong><small data-workspace-meta>organization-visible memory</small></span>
              </span>
              <svg class="workspace-chevron" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-chevron"></use></svg>
            </summary>
            <div class="workspace-menu">
              <span class="workspace-menu-heading" data-workspace-heading>Workspaces</span>
              <div data-workspace-options></div>
              <p>Scopes team-visible memory only — organization-visible records show in every workspace.</p>
            </div>
          </details>
          <select data-workspace-picker aria-label="Active workspace" aria-hidden="true" tabindex="-1" hidden><option value="">Unscoped memory</option></select>
        </div>

        <nav data-product-nav hidden>
          <p class="nav-group-label">Memory</p>
          <button type="button" data-area="atlas" data-label="Memory Atlas" data-scopes={productAreas[0].scopes}>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-atlas"></use></svg>Atlas</span>
            <small>live</small>
          </button>
          <button type="button" data-area="memories" data-label="Memories" data-scopes={productAreas[0].scopes}>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-observation"></use></svg>Memories</span><small>query</small>
          </button>
          <button type="button" data-area="context" data-label="Context" data-scopes={productAreas[1].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-context"></use></svg>Context</span>
            <small>live</small>
          </button>
          <button type="button" data-area="subjects" data-label="Subjects" data-scopes="subjects:read" hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-subject"></use></svg>Subjects</span><small>directory</small>
          </button>

          <p class="nav-group-label">Collaboration</p>
          <button type="button" data-area="work" data-label="Work" data-scopes={productAreas[2].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-work"></use></svg>Work</span>
            <small>live</small>
          </button>

          <p class="nav-group-label">Operations</p>
          <button type="button" data-area="audit" data-label="Audit & Events" data-scopes={productAreas[3].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-audit"></use></svg>Audit &amp; Events</span>
            <small>live</small>
          </button>
          <button type="button" data-area="system" data-label="System status" data-scopes="">
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-system"></use></svg>System</span><small>status</small>
          </button>
          <button type="button" data-area="models" data-label="Models" data-scopes="models:read" hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-model"></use></svg>Models</span><small>env</small>
          </button>
          <button type="button" data-area="federation" data-label="Federation" data-scopes={productAreas[5].scopes} hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-federation"></use></svg>Federation</span>
            <small>live</small>
          </button>

          <p class="nav-group-label">Administration</p>
          <button type="button" data-area="access" data-label="Scoped access control" data-scopes="grants:read principals:read keys:manage" hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-access"></use></svg>Access</span><small>policy</small>
          </button>
          <button type="button" data-area="api" data-label="API & Keys" data-scopes="keys:manage" hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-api"></use></svg>API &amp; Keys</span><small>{ROUTE_INVENTORY.length}</small>
          </button>
          <button type="button" data-area="projects" data-label="Projects" data-scopes="projects:read" hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-project"></use></svg>Projects</span><small>scope</small>
          </button>

          <p class="nav-group-label">Governance</p>
          <button type="button" data-area="governance" data-label="Approvals" data-scopes="governance:read approvals:read" hidden>
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-governance"></use></svg>Approvals</span>
            <small>live</small>
          </button>
          <button type="button" data-area="releases" data-label="Release policy" data-scopes="releases:read">
            <span class="nav-item-label"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#icon-release"></use></svg>Releases</span><small>policy</small>
          </button>
        </nav>

        <section class="credential-note" aria-label="Credential handling">
          <button type="button" class="profile-button" data-profile-open hidden>
            <span class="profile-avatar" data-profile-avatar>OP</span>
            <span><strong data-profile-name>operator</strong><small data-profile-role>profile · principal</small></span>
          </button>
          <p>Credential boundary</p>
          <strong data-credential-mode>Server-only</strong>
          <span data-credential-copy>Passwords and session keys never enter browser storage.</span>
          <button type="button" class="text-button" data-logout aria-label="Sign out" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-disconnect"></use></svg>Disconnect</button>
        </section>
      </aside>

      <main id="workspace" class="main-shell" tabindex="-1">
        <header class="topbar">
          <button type="button" class="menu-button" data-menu-toggle aria-controls="product-navigation" aria-expanded="false" aria-label="Open navigation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.8" /></svg></button>
          <div class="topbar-title">
            <div class="breadcrumb"><span data-breadcrumb-area>Authorized operator surface</span><span>/</span><span data-breadcrumb-page>Dashboard</span></div>
            <div class="topbar-heading"><h1 data-page-title>Titen dashboard</h1><span class="read-only-badge">authorized</span><span class="javanese" title="titen">ꦠꦶꦠꦺꦤ꧀</span></div>
          </div>
          <div class="topbar-actions">
            <button type="button" class="search-button" data-search-open aria-haspopup="dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-search"></use></svg><span>Search or jump to…</span><kbd>⌘K</kbd></button>
            <span class="topbar-rule" aria-hidden="true"></span>
            <div class="connection" role="status" aria-live="polite">
              <i data-connection-dot></i>
              <span data-connection-label>Connecting</span>
              <small data-endpoint>same-origin adapter</small>
            </div>
          </div>
        </header>

        <section class="login-panel" data-login-panel hidden aria-labelledby="login-heading">
          <div class="login-intro">
            <div class="login-brand" aria-label={`Titen version ${packageJson.version}`}>
              <img src={titenMark} width="32" height="32" alt="" />
              <strong>titen</strong>
              <span>v{packageJson.version}</span>
            </div>
            <div>
              <p class="eyebrow">Private operator access</p>
              <h1 id="login-heading" data-login-heading>Sign in</h1>
              <p data-login-copy>Use the operator account issued by your Titen organization.</p>
            </div>
            <p class="login-intro-note">Your permissions decide which memory, work, audit, governance, and federation tools become available.</p>
          </div>
          <form data-login-form>
            <label>
              <span>Username</span>
              <input name="username" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="64" required placeholder="owner" />
            </label>
            <label>
              <span>Password</span>
              <input name="password" type="password" autocomplete="current-password" maxlength="128" required />
            </label>
            <button class="primary-button" type="submit">Continue</button>
            <p class="login-boundary"><strong>Kept off this device.</strong> The adapter exchanges your account for an HttpOnly session and clears both fields after submission.</p>
            <span data-login-status role="status" aria-live="polite"></span>
          </form>
          <form data-password-form hidden>
            <label>
              <span>New password</span>
              <input name="password" type="password" autocomplete="new-password" minlength="15" maxlength="128" required />
            </label>
            <label>
              <span>Confirm new password</span>
              <input name="confirm_password" type="password" autocomplete="new-password" minlength="15" maxlength="128" required />
            </label>
            <button class="primary-button" type="submit">Set new password</button>
            <p class="login-boundary"><strong>First-login requirement.</strong> Updating the password revokes every dashboard session for this user, then asks you to sign in again.</p>
            <span data-password-status role="status" aria-live="polite"></span>
          </form>
        </section>

        <section class="service-strip" data-service-strip hidden aria-label="Service checks">
          <article>
            <span>Process</span>
            <strong data-health>Checking</strong>
            <small data-runtime>healthz</small>
          </article>
          <article>
            <span>Readiness</span>
            <strong data-readiness>Checking</strong>
            <small data-revision>readyz</small>
          </article>
          <article>
            <span>Principal</span>
            <strong data-principal>Server key</strong>
            <small data-role>adapter authority</small>
          </article>
          <button type="button" class="secondary-button" data-reconnect>Refresh service</button>
        </section>

        <div class="notice" data-service-notice role="alert" hidden></div>

        <section class="area-panel query-panel status-panel" data-area-panel="system" hidden aria-labelledby="system-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Operations / live process</p><h2 id="system-heading">System status</h2></div>
            <button class="secondary-button" type="button" data-system-refresh>Refresh status</button>
          </div>
          <div class="status-grid" data-system-status>
            <article><span>Process</span><strong data-system-health>Checking</strong><small data-system-runtime>healthz</small></article>
            <article><span>Readiness</span><strong data-system-readiness>Checking</strong><small data-system-revision>revision pending</small></article>
            <article><span>Connection</span><strong data-system-connection>Checking</strong><small data-system-endpoint>same-origin adapter</small></article>
          </div>
          <div class="live-output compact-output" data-system-checks><p>Readiness checks load with service status.</p></div>
          <p class="panel-note">Readiness separates canonical traffic availability from semantic freshness. Normal projection lag stays ready and is reported as semantic syncing; a 503 still means a required capability needs repair.</p>
        </section>

        <section class="area-panel query-panel policy-panel" data-area-panel="access" hidden aria-labelledby="access-heading">
          <div class="section-heading">
            <div><p class="eyebrow">Administration / two gates</p><h2 id="access-heading">Scoped access control</h2></div>
            <button class="secondary-button" type="button" data-access-refresh>Refresh directory</button>
          </div>
          <dl class="policy-details" data-access-details></dl>
          <section class="user-admin" data-user-admin hidden aria-labelledby="add-user-heading">
            <div><h3 id="add-user-heading">Add a human user</h3><p>Creates one account and organization membership atomically. Titen generates a one-time temporary password; API keys remain for agents and services.</p></div>
            <form data-user-form>
              <label><span>Username</span><input name="username" maxlength="64" pattern="[a-z0-9][a-z0-9._-]{2,63}" autocomplete="off" autocapitalize="none" spellcheck="false" required placeholder="new.operator" /></label>
              <label><span>Role</span><select name="role" required><option>reader</option><option>member</option><option>admin</option><option data-owner-role>owner</option></select></label>
              <label><span>Access profile</span><select name="profile" required><option value="reader">Read dashboard</option><option value="operator">Memory operator</option><option value="admin">Administrator</option></select></label>
              <label><span>Trust ceiling</span><select name="max_trust" required><option>asserted</option><option>verified</option><option>policy_approved</option><option>unverified</option></select></label>
              <button class="primary-button" type="submit">Create user</button>
              <span data-user-status role="status"></span>
              <section class="one-time-credential" data-user-credential hidden aria-label="Temporary password">
                <div><strong>Temporary password</strong><span>Shown once · first login must replace it</span></div>
                <code data-user-temporary-password></code>
                <button class="secondary-button" type="button" data-copy-temporary-password>Copy password</button>
              </section>
            </form>
          </section>
          <div class="dashboard-split">
            <section>
              <h3>Principals and active grants</h3>
              <label class="stack-field"><span>Principal</span><select data-access-principal><option value="">Select a principal</option></select></label>
              <div class="live-output" data-access-output><p>Refresh to inspect the principal directory and active grants.</p></div>
            </section>
            <section data-grant-admin hidden>
              <h3>Add an additive grant</h3>
              <form class="stack-form" data-grant-form>
                <label><span>Principal ID</span><input name="principal_id" maxlength="200" required /></label>
                <label><span>Target</span><select name="target_type"><option>project</option><option>subject</option><option>organization</option></select></label>
                <label><span>Target ID</span><input name="target_id" maxlength="200" placeholder="Project/subject ID; ~ for unscoped" /></label>
                <fieldset class="permission-picker"><legend>Permissions</legend><label><input type="checkbox" name="permissions" value="read" checked />read</label><label><input type="checkbox" name="permissions" value="write" />write</label><label><input type="checkbox" name="permissions" value="approve" />approve</label><label><input type="checkbox" name="permissions" value="admin" />admin</label></fieldset>
                <button class="primary-button" type="submit">Create grant</button><span data-grant-status role="status"></span>
              </form>
            </section>
          </div>
          <form class="inline-form" data-access-simulator>
            <label><span>Principal ID</span><input name="principal_id" maxlength="200" required /></label>
            <label><span>Resource</span><select name="resource_type"><option>claim</option><option>observation</option></select></label>
            <label><span>Resource ID</span><input name="resource_id" maxlength="200" required /></label>
            <label><span>Operation</span><select name="operation"><option>read</option><option>write</option><option>approve</option></select></label>
            <button class="secondary-button" type="submit">Simulate gates</button>
          </form>
          <div class="live-output compact-output" data-access-simulation><p>Visibility and grant gates must both pass.</p></div>
          <p class="panel-note">Denied memory is absent from results, counts, cursors, rank, disputes, and citations. Owner override remains explicit and audited.</p>
        </section>

        <section class="area-panel query-panel" data-area-panel="subjects" hidden aria-labelledby="subjects-heading">
