        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const username = form.elements.namedItem("username") as HTMLInputElement;
        const password = form.elements.namedItem("password") as HTMLInputElement;
        text("[data-login-status]", "Signing in…");
        try {
          principal = await login(username.value, password.value);
          password.value = "";
          await refreshService();
        } catch (error) {
          password.value = "";
          text("[data-login-status]", errorMessage(error));
        }
      });
      one<HTMLFormElement>("[data-password-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const password = form.elements.namedItem("password") as HTMLInputElement;
        const confirm = form.elements.namedItem("confirm_password") as HTMLInputElement;
        if (password.value !== confirm.value) return text("[data-password-status]", "Passwords do not match.");
        text("[data-password-status]", "Updating password…");
        try {
          await changePassword(password.value);
          signedOut("Password updated. Sign in with your new password.");
        } catch (error) {
          password.value = "";
          confirm.value = "";
          text("[data-password-status]", errorMessage(error));
        }
      });
      one<HTMLButtonElement>("[data-logout]").addEventListener("click", async () => {
        try {
          await logout();
          signedOut("Signed out. The adapter discarded this browser session.");
        } catch (error) { handleError(error); }
      });
      one<HTMLButtonElement>("[data-profile-open]").addEventListener("click", () => activateArea("profile"));
      one<HTMLFormElement>("[data-profile-password-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const password = form.elements.namedItem("password") as HTMLInputElement;
        const confirm = form.elements.namedItem("confirm_password") as HTMLInputElement;
        if (password.value !== confirm.value) return text("[data-profile-password-status]", "Passwords do not match.");
        text("[data-profile-password-status]", "Updating password…");
        try {
          await changePassword(password.value);
          signedOut("Password updated. Sign in with your new password.");
        } catch (error) {
          password.value = "";
          confirm.value = "";
          text("[data-profile-password-status]", errorMessage(error));
        }
      });
      one<HTMLButtonElement>("[data-reconnect]").addEventListener("click", refreshService);
      one<HTMLButtonElement>("[data-system-refresh]").addEventListener("click", refreshService);
      one<HTMLButtonElement>("[data-search-open]").addEventListener("click", () => {
        searchDialog.showModal();
        (searchForm.elements.namedItem("query") as HTMLInputElement).focus();
      });
      searchForm.addEventListener("submit", (event) => {
        const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
        if (submitter?.value !== "default") return;
        event.preventDefault();
        const query = String(new FormData(searchForm).get("query") ?? "").trim();
        memoryListSearch.value = query;
        memoryListHistory = [];
        memoryListCursor = null;
        searchDialog.close();
        activateArea("memories");
        memoryListSearch.focus();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && workspaceMenu.open) {
          workspaceMenu.open = false;
          one<HTMLElement>("[data-workspace-menu] summary").focus();
          return;
        }
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          if (!searchDialog.open) one<HTMLButtonElement>("[data-search-open]").click();
        }
      });
      document.addEventListener("pointerdown", (event) => {
        if (workspaceMenu.open && !workspaceMenu.contains(event.target as Node)) workspaceMenu.open = false;
      });

      memoryListForm.addEventListener("submit", (event) => {
        event.preventDefault();
        memoryListHistory = [];
        memoryListCursor = null;
        void loadMemoryList();
      });
      memoryListNext.addEventListener("click", () => {
        if (!memoryListCursor) return;
        memoryListHistory.push(memoryListAfter ?? "");
        void loadMemoryList(memoryListCursor);
      });
      memoryListPrev.addEventListener("click", () => {
        const cursor = memoryListHistory.pop() ?? "";
        void loadMemoryList(cursor || null);
      });

      memoryForm.addEventListener("change", (event) => {
        if ((event.target as HTMLInputElement).name === "lens") updateMemoryRequirements();
        if ((event.target as HTMLInputElement).name === "administrator_view") {
          const enabled = (event.target as HTMLInputElement).checked;
          (memoryForm.elements.namedItem("administrator_reason") as HTMLSelectElement).disabled = !enabled;
        }
      });
      memoryForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!memoryForm.reportValidity()) return;
        const values = new FormData(memoryForm);
        const payload: Record<string, unknown> = { lens: String(values.get("lens")), limit: Number(values.get("limit")) };
        const subject = String(values.get("subject_id") ?? "").trim();
        const focus = String(values.get("focus_id") ?? "").trim();
        if (subject) payload.subject_id = subject;
        if (focus) payload.focus_id = focus;
        if (payload.lens === "workspace_graph") {
          if (workspacePicker.value) payload.workspace_id = workspacePicker.value;
          payload.max_nodes = Math.max(25, Number(values.get("limit")));
        }
        if (values.get("administrator_view") === "on") {
          payload.access_mode = "organization_admin";
          payload.administrator_reason = String(values.get("administrator_reason"));
        }
        clearMemory();
        const current = generation;
        memoryLoading.hidden = false;
        memoryEmpty.hidden = true;
        memoryRun.disabled = true;
        text("[data-memory-status]", "Compiling authorized memory view…");
        try {
          const next = await compileView(payload);
          if (current !== generation) return;
          renderMemory(next);
          text("[data-memory-status]", "Live view compiled from the Titen API.");
        } catch (error) {
          if (current !== generation) return;
          clearMemory();
          setNotice(memoryError, errorMessage(error));
          handleError(error);
        } finally { memoryLoading.hidden = true; memoryRun.disabled = false; }
      });

      one<HTMLFormElement>("[data-context-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const values = new FormData(form);
        const body: Record<string, unknown> = {
          subject_id: String(values.get("subject_id")).trim(),
          task: String(values.get("task")).trim(),
          max_tokens: Number(values.get("max_tokens")),
        };
        const project = String(values.get("project_id") ?? "").trim();
        if (project) body.project_id = project;
        const target = one<HTMLElement>("[data-context-output]");
        renderMessage(target, "Compiling authorized context…");
        try { renderContext(target, await postArea("context/compile", body)); text("[data-context-status]", "Live context compiled."); }
        catch (error) { handleError(error, target); }
      });
      one<HTMLButtonElement>("[data-work-refresh]").addEventListener("click", async () => {
        try { await loadWork(); }
        catch (error) { handleError(error, one("[data-work-output]")); }
      });
      one<HTMLFormElement>("[data-checkpoint-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const values = new FormData(form);
        const query = new URLSearchParams();
        for (const field of ["subject_id", "agent_id", "kind"]) query.set(field, String(values.get(field)).trim());
        const target = one<HTMLElement>("[data-work-output]");
        try { renderPayload(target, await getArea("work/checkpoint", query)); } catch (error) { handleError(error, target); }
      });
      one<HTMLButtonElement>("[data-audit-refresh]").addEventListener("click", async () => {
        const values = new FormData(one<HTMLFormElement>("[data-audit-form]"));
        const limit = String(values.get("limit"));
        const requests: Array<[string, string]> = [];
        const action = String(values.get("action") ?? "").trim();
        const kind = String(values.get("kind") ?? "").trim();
        requests.push([`audit/log?limit=${encodeURIComponent(limit)}${action ? `&action=${encodeURIComponent(action)}` : ""}`, "audit:read"]);
        requests.push([`audit/events?limit=${encodeURIComponent(limit)}${kind ? `&kind=${encodeURIComponent(kind)}` : ""}`, "events:read"]);
        try { await loadAvailable(one("[data-audit-output]"), requests); } catch (error) { handleError(error, one("[data-audit-output]")); }
      });
      one<HTMLButtonElement>("[data-governance-refresh]").addEventListener("click", async () => {
        try { await loadGovernance(); }
        catch (error) { handleError(error, one("[data-governance-output]")); }
      });
      one<HTMLFormElement>("[data-user-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        if (!form.reportValidity()) return;
        const values = new FormData(form);
        const profile = String(values.get("profile"));
        text("[data-user-status]", "Creating account and membership atomically…");
        try {
          const response = await postArea("governance/users", {
            username: String(values.get("username")).trim().toLowerCase(),
            role: String(values.get("role")),
            scopes: profiles[profile]!,
            max_trust: String(values.get("max_trust")),
          });
          const data = payloadData(response);
          if (typeof data.temporary_password !== "string")
            throw new DashboardApiError(502, "INVALID_UPSTREAM_RESPONSE", "Titen did not return the one-time password.");
          form.reset();
          text("[data-user-temporary-password]", data.temporary_password);
          one<HTMLElement>("[data-user-credential]").hidden = false;
          text("[data-user-status]", `Created ${data.username} with role ${data.role}. Copy the temporary password now.`);
        } catch (error) { text("[data-user-status]", errorMessage(error)); handleError(error); }
      });
      one<HTMLButtonElement>("[data-copy-temporary-password]").addEventListener("click", async () => {
        const value = one<HTMLElement>("[data-user-temporary-password]").textContent ?? "";
        try {
          await navigator.clipboard.writeText(value);
          text("[data-user-status]", "Temporary password copied.");
        } catch { text("[data-user-status]", "Copy failed. Select the temporary password manually."); }
      });
      one<HTMLButtonElement>("[data-federation-refresh]").addEventListener("click", async () => {
        const target = one<HTMLElement>("[data-federation-output]");
        try { renderPayload(target, await getArea("federation/peers")); } catch (error) { handleError(error, target); }
      });
      one<HTMLFormElement>("[data-federation-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const values = new FormData(event.currentTarget as HTMLFormElement);
        const query = new URLSearchParams({ peer_id: String(values.get("peer_id")).trim(), limit: String(values.get("limit")) });
        const target = one<HTMLElement>("[data-federation-output]");
        try {
          const response = await getArea("federation/log", query);
          renderPayload(target, { data: { federation_entries: payloadData(response).entries ?? [] } });
        } catch (error) { handleError(error, target); }
      });
      one<HTMLButtonElement>("[data-releases-refresh]").addEventListener("click", async () => {
        const target = one<HTMLElement>("[data-releases-output]");
        try { await loadReleases(); }
        catch (error) { handleError(error, target); }
      });

      workspacePicker.addEventListener("change", () => {
        renderWorkspacePicker();
        memoryListHistory = [];
        memoryListCursor = null;
        if (!one<HTMLElement>('[data-area-panel="memories"]').hidden) void loadMemoryList();
        clearMemory();
      });
      one<HTMLButtonElement>("[data-subjects-refresh]").addEventListener("click", loadSubjects);
      one<HTMLFormElement>("[data-subjects-form]").addEventListener("submit", (event) => { event.preventDefault(); void loadSubjects(); });
      one<HTMLButtonElement>("[data-projects-refresh]").addEventListener("click", loadProjects);
      one<HTMLFormElement>("[data-projects-form]").addEventListener("submit", (event) => { event.preventDefault(); void loadProjects(); });
      one<HTMLButtonElement>("[data-models-refresh]").addEventListener("click", loadModels);
      for (const button of all<HTMLButtonElement>("[data-model-probe]")) button.addEventListener("click", async () => {
        text("[data-model-status]", `Probing ${button.dataset.modelProbe} without a canonical write…`);
        try {
          const response = await postArea("models/probe", { group: button.dataset.modelProbe! });
          text("[data-model-status]", JSON.stringify(payloadData(response)));
        } catch (error) { text("[data-model-status]", errorMessage(error)); }
      });
      one<HTMLButtonElement>("[data-access-refresh]").addEventListener("click", loadAccess);
      one<HTMLSelectElement>("[data-access-principal]").addEventListener("change", (event) => {
        const value = (event.currentTarget as HTMLSelectElement).value;
        (one<HTMLFormElement>("[data-grant-form]").elements.namedItem("principal_id") as HTMLInputElement).value = value;
        (one<HTMLFormElement>("[data-access-simulator]").elements.namedItem("principal_id") as HTMLInputElement).value = value;
        void loadAccess();
      });
      one<HTMLFormElement>("[data-grant-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const values = new FormData(form);
        const type = String(values.get("target_type"));
        const rawTarget = String(values.get("target_id") ?? "").trim();
        const target = type === "organization" ? undefined : type === "project" && rawTarget === "~" ? null : rawTarget;
        text("[data-grant-status]", "Creating bounded grant…");
        try {
          await postArea("access/grants", {
            principal_id: String(values.get("principal_id")).trim(), target_type: type,
            ...(target !== undefined ? { target_id: target } : {}),
            permissions: values.getAll("permissions").map(String),
          });
          text("[data-grant-status]", "Grant created; next request uses it.");
          await loadAccess();
        } catch (error) { text("[data-grant-status]", errorMessage(error)); }
      });
      one<HTMLFormElement>("[data-access-simulator]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const body = Object.fromEntries(new FormData(event.currentTarget as HTMLFormElement));
        const target = one<HTMLElement>("[data-access-simulation]");
        renderMessage(target, "Evaluating both canonical gates…");
        try { renderPayload(target, await postArea("access/simulate", body)); }
        catch (error) { handleError(error, target); }
      });
      const filterRoutes = () => {
        const values = new FormData(one<HTMLFormElement>("[data-route-filter]"));
        const q = String(values.get("q") ?? "").trim().toLowerCase();
        const method = String(values.get("method") ?? "");
        let visible = 0;
        for (const row of all<HTMLElement>("[data-route-rows] tr")) {
          row.hidden = Boolean((q && !row.dataset.search?.includes(q)) || (method && row.dataset.method !== method));
          if (!row.hidden) visible += 1;
        }
        text("[data-route-count]", String(visible));
      };
      one<HTMLFormElement>("[data-route-filter]").addEventListener("input", filterRoutes);
      one<HTMLButtonElement>("[data-keys-refresh]").addEventListener("click", loadKeys);
      one<HTMLFormElement>("[data-key-form]").addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const values = new FormData(form);
        const type = String(values.get("data_target_type"));
        const rawTarget = String(values.get("data_target_id") ?? "").trim();
        const target = type === "organization" ? undefined : type === "project" && rawTarget === "~" ? null : rawTarget;
        text("[data-key-status]", "Generating a bounded credential…");
        try {
          const response = await postArea("api/keys", {
            label: String(values.get("label")).trim(), principal_kind: String(values.get("principal_kind")),
            scopes: String(values.get("scopes")).split(",").map((scope) => scope.trim()).filter(Boolean),
            max_trust: String(values.get("max_trust")), data_target_type: type,
            ...(target !== undefined ? { data_target_id: target } : {}),
          });
          const data = payloadData(response);
          if (typeof data.api_key !== "string") throw new DashboardApiError(502, "INVALID_UPSTREAM_RESPONSE", "Titen did not return the one-time key.");
          text("[data-key-secret]", data.api_key);
          one<HTMLElement>("[data-key-credential]").hidden = false;
          text("[data-key-status]", "Key created. Copy it now; Titen stores only the hash.");
          await loadKeys();
        } catch (error) { text("[data-key-status]", errorMessage(error)); }
      });

      updateMemoryRequirements();
      clearPrivateState();
      refreshService();
    </script>
  </body>
</html>
