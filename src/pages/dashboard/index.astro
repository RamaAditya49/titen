          const data = payloadData(await getArea("workspaces"));
          const current = workspacePicker.value;
          workspacePicker.replaceChildren(new Option("Unscoped memory", ""));
          for (const workspace of Array.isArray(data.workspaces) ? data.workspaces : []) {
            if (!workspace || typeof workspace !== "object") continue;
            const row = workspace as Record<string, unknown>;
            if (typeof row.workspace_id === "string" && typeof row.name === "string")
              workspacePicker.add(new Option(row.name, row.workspace_id));
          }
          workspacePicker.value = [...workspacePicker.options].some((option) => option.value === current) ? current : "";
          renderWorkspacePicker();
          one<HTMLElement>("[data-workspace-control]").hidden = false;
        } catch (error) { handleError(error); }
      }
      function renderWorkspacePicker() {
