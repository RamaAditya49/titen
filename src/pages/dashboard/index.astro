      async function loadAvailable(
        target: HTMLElement,
        requests: Array<[string, string]>,
        options: Parameters<typeof renderPayloadView>[2] = {},
      ): Promise<Record<string, unknown>> {
        renderMessage(target, "Loading authorized live data…");
        const selected = requests.filter(([, scope]) => has(scope));
        if (!selected.length) {
          renderMessage(target, "This principal has no read capability for this area.");
          return {};
        }
        const results = await Promise.all(selected.map(async ([path]) => [path.split("/").at(-1)!, await getArea(path)] as const));
        const merged: Record<string, unknown> = {};
        for (const [name, payload] of results) Object.assign(merged, payloadData(payload));
        renderPayload(target, { data: merged }, options);
        return merged;
      }

      function formQuery(form: HTMLFormElement): URLSearchParams {
        const query = new URLSearchParams();
        for (const [key, value] of new FormData(form))
          if (String(value).trim()) query.set(key, String(value).trim());
        return query;
      }
      async function loadWorkspaces() {
        if (!has("workspaces:read")) return;
