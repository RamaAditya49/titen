      async function loadWork() {
        const target = one<HTMLElement>("[data-work-output]");
        renderMessage(target, "Loading authorized work state…");
        const requests = [["work/leases?limit=50", "leases:read"], ["work/handoffs", "handoffs:read"]] as Array<[string, string]>;
        const selected = requests.filter(([, scope]) => has(scope));
        if (!selected.length) return renderMessage(target, "This principal has no read capability for work state.");
        const responses = await Promise.all(selected.map(async ([path]) => payloadData(await getArea(path))));
        const data = Object.assign({}, ...responses);
        renderPayload(target, { data }, { actions: {
          leases: (row) => {
            if (!has("leases:write") || typeof row.lease_id !== "string" || row.status !== "active") return [];
            const own = row.holder_id === principal?.principal_id;
            const privileged = ["root", "owner", "admin"].includes(principal?.organization_role ?? "");
            if (!own && !privileged) return [];
            const verb = own ? "Release" : "Force-release";
            return [{
              label: `${verb} · ${row.resource_id ?? row.lease_id}`,
              tone: "danger",
              run: async () => {
                if (!confirm(`${verb} this lease now?`)) return;
                try {
                  if (own) await deleteArea(`work/leases/${encodeURIComponent(row.lease_id as string)}`);
                  else await postArea(`work/leases/${encodeURIComponent(row.lease_id as string)}/force-release`, {});
                  await loadWork();
                } catch (error) { handleError(error, target); }
              },
            }];
          },
          handoffs: (row) => {
            if (!has("handoffs:write") || typeof row.handoff_id !== "string" || row.status !== "pending" || row.to_principal !== principal?.principal_id) return [];
            return (["accepted", "rejected"] as const).map((status) => ({
              label: `${status === "accepted" ? "Accept" : "Reject"} handoff · ${row.subject_id}`,
              tone: status === "rejected" ? "danger" as const : "default" as const,
              run: async () => {
                if (!confirm(`${status === "accepted" ? "Accept" : "Reject"} this handoff?`)) return;
                try {
                  await postArea(`work/handoffs/${encodeURIComponent(row.handoff_id as string)}/resolve`, { status });
