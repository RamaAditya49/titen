---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/jetbrains-mono";
import "../../styles/dashboard.css";
import titenMark from "../../../docs/assets/brand/titen-mark.svg?url";
import packageJson from "../../../package.json";

const productAreas = [
  { name: "Memories", status: "4 live lenses" },
  { name: "Context", status: "headless API" },
  { name: "Work", status: "headless API" },
  { name: "Audit", status: "Atlas refs" },
  { name: "Governance", status: "2 live lenses" },
  { name: "Federation", status: "canonical recall" },
];
const lenses = [
  { id: "neighborhood", label: "Neighborhood", needs: "subject" },
  { id: "evidence_trace", label: "Evidence trace", needs: "focus" },
  { id: "conflict_freshness", label: "Conflict & freshness", needs: "subject" },
  { id: "review_queue", label: "Review queue", needs: "optional" },
  { id: "scope_preview", label: "Scope preview", needs: "focus" },
  { id: "knowledge_release", label: "Knowledge releases", needs: "optional" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Titen Memory Atlas — live, authorized memory inspection." />
    <title>Titen · Live Memory Atlas</title>
  </head>
  <body>
    <a class="skip-link" href="#workspace">Skip to workspace</a>
    <div class="app-shell">
      <aside class="sidebar" aria-label="Product areas">
        <header class="brand-row">
          <img src={titenMark} width="24" height="24" alt="" />
          <strong>titen</strong>
          <span>v{packageJson.version}</span>
        </header>

        <nav>
          <p>Memory</p>
          <a href="/dashboard/" aria-current="page">Memory Atlas</a>
          <p>Product map</p>
          {productAreas.map((area) => <span class="inactive-area">{area.name}<small>{area.status}</small></span>)}
        </nav>

        <section class="credential-note" aria-label="Credential handling">
          <p>Credential boundary</p>
          <strong>Server-only</strong>
          <span>The browser uses same-origin routes. API keys stay in the adapter process.</span>
        </section>
      </aside>

      <main id="workspace" class="main-shell" tabindex="-1">
        <header class="topbar">
          <div>
            <p class="eyebrow">Operator surface / read only</p>
            <h1>Live Memory Atlas</h1>
          </div>
          <div class="connection" role="status" aria-live="polite">
            <i data-connection-dot></i>
            <span data-connection-label>Connecting</span>
            <small data-endpoint>same-origin adapter</small>
          </div>
        </header>

        <section class="service-strip" aria-label="Service checks">
          <article>
            <span>Process</span>
            <strong data-health>Checking</strong>
            <small data-runtime>healthz</small>
          </article>
          <article>
            <span>Readiness</span>
            <strong data-readiness>Checking</strong>
            <small data-revision>readyz</small>
          </article>
          <article>
            <span>Projection</span>
            <strong data-projection>No query</strong>
            <small>authorized SQL view</small>
          </article>
          <button type="button" class="secondary-button" data-reconnect>Refresh service</button>
        </section>

        <div class="notice" data-service-notice role="alert" hidden></div>

        <section class="query-panel" aria-labelledby="query-heading">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Bounded query</p>
              <h2 id="query-heading">Choose what the API may return</h2>
            </div>
            <span>Nothing is stored in this browser.</span>
          </div>

          <form data-query-form>
            <fieldset class="lens-picker">
              <legend>Atlas lens</legend>
              {lenses.map((lens, index) => (
                <label>
                  <input type="radio" name="lens" value={lens.id} data-needs={lens.needs} checked={index === 0} />
                  <span>{lens.label}</span>
                </label>
              ))}
            </fieldset>

            <div class="input-grid">
              <label>
                <span>Subject ID</span>
                <input name="subject_id" autocomplete="off" maxlength="200" placeholder="subject or project identity" required />
                <small data-subject-help>Required for the selected lens.</small>
              </label>
              <label>
                <span data-focus-label>Focus claim ID</span>
                <input name="focus_id" autocomplete="off" maxlength="200" placeholder="claim ID for evidence trace" />
                <small data-focus-help>Used only by Evidence trace.</small>
              </label>
              <label>
                <span>Result limit</span>
                <input name="limit" type="number" min="1" max="100" value="50" inputmode="numeric" required />
                <small>Server limit: 1–100.</small>
              </label>
            </div>

            <div class="form-actions">
              <button class="primary-button" type="submit" data-run>Compile authorized view</button>
              <span data-query-status role="status" aria-live="polite">Enter an authorized scope to begin.</span>
            </div>
          </form>
        </section>

        <section class="atlas-workspace" aria-label="Atlas result">
          <div class="result-column">
            <header class="result-header">
              <div>
                <p class="eyebrow">Canonical projection</p>
                <h2 data-view-title>Waiting for a live query</h2>
              </div>
              <span data-result-count>0 records</span>
            </header>

            <div class="loading-state" data-loading hidden aria-label="Loading Atlas records">
              <span></span><span></span><span></span>
            </div>
            <div class="empty-state" data-empty>
              <strong>No fixture is loaded.</strong>
              <p>Run a bounded query to inspect records authorized for the adapter credential.</p>
            </div>
            <div class="notice" data-query-error role="alert" hidden></div>
            <div class="record-list" data-records hidden></div>
          </div>

          <aside class="inspector" aria-labelledby="inspector-heading">
            <header>
              <p class="eyebrow">Selected record</p>
              <h2 id="inspector-heading" data-inspector-title>Nothing selected</h2>
            </header>
            <div class="inspector-empty" data-inspector-empty>Select a returned record to inspect canonical fields and relationships.</div>
            <div data-inspector-body hidden>
              <dl data-node-fields></dl>
              <section>
                <h3>Relationships</h3>
                <div data-relationships></div>
              </section>
            </div>
          </aside>
        </section>

        <details class="metadata-panel">
          <summary>View metadata</summary>
          <pre data-metadata>No live view compiled.</pre>
        </details>
      </main>
    </div>

    <script>
      import {
        DashboardApiError,
        checkService,
        compileView,
        getDashboardStatus,
        type AtlasNode,
        type AtlasView,
      } from "../../lib/dashboard-api";

      const one = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
      const form = one<HTMLFormElement>("[data-query-form]");
      const runButton = one<HTMLButtonElement>("[data-run]");
      const records = one<HTMLElement>("[data-records]");
      const empty = one<HTMLElement>("[data-empty]");
      const loading = one<HTMLElement>("[data-loading]");
      const queryError = one<HTMLElement>("[data-query-error]");
      let view: AtlasView | null = null;

      function text(selector: string, value: string) { one<HTMLElement>(selector).textContent = value; }
      function data(payload: Record<string, unknown>): Record<string, unknown> {
        return payload.data && typeof payload.data === "object"
          ? payload.data as Record<string, unknown>
          : payload.error && typeof payload.error === "object"
            ? payload.error as Record<string, unknown>
            : payload;
      }
      function serviceDetail(payload: Record<string, unknown>, key: string): string | undefined {
        const value = data(payload)[key];
        return typeof value === "string" ? value : undefined;
      }
      function setNotice(element: HTMLElement, message?: string) {
        element.hidden = !message;
        element.textContent = message ?? "";
      }
      function errorMessage(error: unknown): string {
        if (error instanceof DashboardApiError) {
          if (error.status === 401) return "Authentication failed. Replace the server-side dashboard credential.";
          if (error.status === 403) return "This credential is not authorized for the selected view.";
          if (error.status === 503) return "Titen is not ready. Inspect readiness before retrying.";
          return error.message;
        }
        return "The same-origin dashboard adapter is unreachable.";
      }

      function updateRequirements() {
        const selected = one<HTMLInputElement>('input[name="lens"]:checked');
        const subject = form.elements.namedItem("subject_id") as HTMLInputElement;
        const focus = form.elements.namedItem("focus_id") as HTMLInputElement;
        const lens = selected.value;
        subject.required = selected.dataset.needs === "subject";
        focus.required = selected.dataset.needs === "focus";
        text("[data-subject-help]", subject.required ? "Required for the selected lens." : lens === "review_queue" ? "Optional filter for Review queue." : "Not used by the selected lens.");
        const focusCopy = lens === "evidence_trace"
          ? ["Focus claim ID", "claim ID for evidence trace", "Required for Evidence trace."]
          : lens === "scope_preview"
            ? ["Focus principal ID", "principal ID to preview", "Required for Scope preview."]
            : lens === "knowledge_release"
              ? ["Focus channel ID", "optional channel ID", "Optional; leave blank to include all authorized channels."]
              : ["Focus ID", "not used by selected lens", "Not used by the selected lens."];
        text("[data-focus-label]", focusCopy[0]);
        focus.placeholder = focusCopy[1];
        text("[data-focus-help]", focusCopy[2]);
      }

      function formatDate(value: string, detailed = false): string | undefined {
        if (!value) return;
        const date = new Date(value);
        return Number.isNaN(date.valueOf()) ? undefined : detailed ? date.toLocaleString() : date.toLocaleDateString();
      }

      function addField(list: HTMLDListElement, label: string, value: unknown) {
        if (value === undefined || value === null || value === "") return;
        const term = document.createElement("dt");
        const description = document.createElement("dd");
        term.textContent = label;
        description.textContent = Array.isArray(value) ? value.join(", ") || "none" : String(value);
        list.append(term, description);
      }

      function inspect(node: AtlasNode) {
        records.querySelectorAll("button").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.id === node.id)));
        text("[data-inspector-title]", node.label);
        one<HTMLElement>("[data-inspector-empty]").hidden = true;
        one<HTMLElement>("[data-inspector-body]").hidden = false;
        const fields = one<HTMLDListElement>("[data-node-fields]");
        fields.replaceChildren();
        addField(fields, "ID", node.id);
        addField(fields, "Type", node.type);
        addField(fields, "Trust", node.trust);
        addField(fields, "Status", node.status);
        addField(fields, "Created", formatDate(node.created_at, true));
        addField(fields, "Freshness", node.freshness === undefined ? undefined : `${node.freshness} days`);
        addField(fields, "Confidence", node.confidence);
        addField(fields, "Priority", node.priority);
        addField(fields, "Reasons", node.reasons);
        addField(fields, "Owner", node.owner_id);
        addField(fields, "Next action", node.next_action);
        addField(fields, "Deadline", node.deadline);
        addField(fields, "Evidence refs", node.evidence_refs);
        addField(fields, "Audit refs", node.audit_refs);

        const relationships = one<HTMLElement>("[data-relationships]");
        relationships.replaceChildren();
        const edges = view?.edges.filter((edge) => edge.from === node.id || edge.to === node.id) ?? [];
        if (!edges.length) relationships.textContent = "No relationships returned in this view.";
        for (const edge of edges) {
          const row = document.createElement("p");
          row.textContent = `${edge.from} — ${edge.relation} → ${edge.to}`;
          relationships.append(row);
        }
      }

      function render(next: AtlasView) {
        view = next;
        records.replaceChildren();
        text("[data-view-title]", next.lens.replaceAll("_", " "));
        text("[data-result-count]", `${next.nodes.length} record${next.nodes.length === 1 ? "" : "s"} · ${next.edges.length} edge${next.edges.length === 1 ? "" : "s"}`);
        text("[data-projection]", next.nodes.length ? "Live data" : "Empty");
        text("[data-metadata]", JSON.stringify(next.metadata, null, 2));
        empty.hidden = next.nodes.length > 0;
        if (!next.nodes.length) {
          empty.querySelector("strong")!.textContent = "No authorized records found.";
          empty.querySelector("p")!.textContent = "The query succeeded. Adjust the subject, focus, or review filter if you expected data.";
        }
        records.hidden = next.nodes.length === 0;
        for (const node of next.nodes) {
          const button = document.createElement("button");
          button.type = "button";
          button.dataset.id = node.id;
          button.setAttribute("aria-pressed", "false");
          const kind = document.createElement("span");
          const label = document.createElement("strong");
          const detail = document.createElement("small");
          kind.textContent = node.type;
          kind.className = "record-kind";
          label.textContent = node.label;
          detail.textContent = [node.trust, node.status, formatDate(node.created_at)].filter(Boolean).join(" · ");
          button.append(kind, label, detail);
          button.addEventListener("click", () => inspect(node));
          records.append(button);
        }
        if (next.nodes[0]) inspect(next.nodes[0]);
      }

      async function refreshService() {
        const notice = one<HTMLElement>("[data-service-notice]");
        text("[data-connection-label]", "Connecting");
        one<HTMLElement>("[data-connection-dot]").className = "";
        try {
          const status = await getDashboardStatus();
          if (status.mode !== "live") throw new DashboardApiError(503, "DASHBOARD_DISCONNECTED", "Live dashboard integration is disabled.");
          text("[data-endpoint]", status.endpoint ?? "configured endpoint");
          const [health, readiness] = await Promise.all([checkService("health"), checkService("readiness")]);
          text("[data-health]", health.ok ? serviceDetail(health.payload, "status") ?? "Healthy" : `Error ${health.status}`);
          text("[data-runtime]", serviceDetail(health.payload, "runtime") ?? "healthz");
          text("[data-readiness]", readiness.ok ? "Ready" : `Not ready · ${readiness.status}`);
          text("[data-revision]", serviceDetail(health.payload, "revision") ?? "revision unavailable");
          text("[data-connection-label]", health.ok ? "Connected" : "Degraded");
          one<HTMLElement>("[data-connection-dot]").className = health.ok && readiness.ok ? "ok" : "warn";
          setNotice(notice, readiness.ok ? undefined : "The process is reachable but not ready. Atlas requests may fail until readiness recovers.");
          runButton.disabled = !health.ok;
        } catch (error) {
          text("[data-connection-label]", "Disconnected");
          text("[data-endpoint]", "same-origin adapter unavailable");
          text("[data-health]", "Unavailable");
          text("[data-readiness]", "Unavailable");
          one<HTMLElement>("[data-connection-dot]").className = "bad";
          setNotice(notice, `${errorMessage(error)} Configure TITEN_API_URL and TITEN_API_KEY in the dashboard adapter process.`);
          runButton.disabled = true;
        }
      }

      form.addEventListener("change", (event) => {
        if ((event.target as HTMLInputElement).name === "lens") updateRequirements();
      });
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        const values = new FormData(form);
        const lens = String(values.get("lens"));
        const subject = String(values.get("subject_id") ?? "").trim();
        const focus = String(values.get("focus_id") ?? "").trim();
        const limit = Number(values.get("limit"));
        const payload: Record<string, unknown> = { lens, limit };
        if (subject) payload.subject_id = subject;
        if (focus) payload.focus_id = focus;
        loading.hidden = false;
        empty.hidden = true;
        records.hidden = true;
        setNotice(queryError);
        runButton.disabled = true;
        text("[data-query-status]", "Compiling authorized view…");
        try {
          render(await compileView(payload));
          text("[data-query-status]", "Live view compiled from the Titen API.");
        } catch (error) {
          view = null;
          setNotice(queryError, errorMessage(error));
          text("[data-query-status]", "Query failed without a fixture fallback.");
          text("[data-projection]", "Query failed");
        } finally {
          loading.hidden = true;
          runButton.disabled = false;
        }
      });
      one<HTMLButtonElement>("[data-reconnect]").addEventListener("click", refreshService);
      updateRequirements();
      refreshService();
    </script>
  </body>
</html>
